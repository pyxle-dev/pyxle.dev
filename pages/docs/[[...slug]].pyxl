from pyxle import __version__
import json
import os
import re
from pathlib import Path

# ═══ /docs — The Working Copy: the manual ═══════════════════════════
# The docs are the manual of the working copy, one numbered listing
# (lines 01..NN). `/docs` is the landing — the printed index; a
# `/docs/<path>` article is one printed page (running head, folio
# numeral = its line number, claim/receipt couplet). Article HTML
# comes from the generated public/docs-data JSON and is transformed
# HERE, server-side, into the house chrome (Sheet code panes with Deck
# heads and the server/client badges, wrapped tables, heading
# anchors) — so the SSR document already carries the finished article
# and the client only hydrates behaviour on top. Body prose is
# untouched.

DOCS_DIR = Path(os.getcwd()) / "public" / "docs-data"

# Caches keyed on process lifetime — docs-data is regenerated only by
# scripts/build-docs.mjs + a redeploy (same trade the manifest cache
# has always made).
_manifest_cache = None
_listing_cache = None
_page_cache = {}


def _read_manifest():
    global _manifest_cache
    if _manifest_cache is None:
        manifest_path = DOCS_DIR / "manifest.json"
        if manifest_path.exists():
            _manifest_cache = json.loads(manifest_path.read_text())
    return _manifest_cache


def _is_safe_slug(slug: str) -> bool:
    """Reject anything that looks like a path-traversal attempt.

    Starlette's routing normalises most of these already, but defence-in-depth
    is cheap: we reject leading slashes, '..' segments, backslashes, and
    control characters before the value is joined with DOCS_DIR.
    """
    if not slug:
        return True
    if "\\" in slug or "\0" in slug:
        return False
    if slug.startswith("/") or slug.startswith("."):
        return False
    parts = slug.split("/")
    return all(part and part != ".." for part in parts)


def _listing():
    """The manifest nav flattened into the numbered listing.

    Returns ``(shelves, meta_of, total)`` where shelves are the nav
    categories with per-item line numbers (01..NN in reading order) and
    curated search keywords (the ⌘K palette index), and ``meta_of`` maps
    a page path to its ``{"line", "cat"}``. Cached for the process.
    """
    global _listing_cache
    if _listing_cache is None:
        manifest = _read_manifest()
        if manifest is None:
            return None
        keywords = {
            entry["path"]: " ".join(entry.get("keywords", []))
            for entry in manifest.get("searchIndex", [])
        }
        shelves = []
        meta_of = {}
        line = 0
        for cat in manifest["nav"]:
            items = []
            for item in cat["items"]:
                line += 1
                meta_of[item["path"]] = {"line": line, "cat": cat["slug"]}
                items.append({
                    "title": item["title"],
                    "path": item["path"],
                    "line": line,
                    "k": keywords.get(item["path"], ""),
                })
            shelves.append({"category": cat["category"], "slug": cat["slug"], "items": items})
        _listing_cache = (shelves, meta_of, line)
    return _listing_cache


# ── the body transform: code frames, wrapped tables, anchors ─────────
# It operates on the already-escaped generated HTML. Real syntax
# highlighting lives in highlight.py (app root): Python through the
# stdlib tokenizer, JS/JSX through a stateful scanner, JSON, and the
# two-domain ```pyxl split — those engines take raw source, so blocks
# they own are unescaped first and come back as finished escaped HTML.
# The shell-and-config languages keep the quiet treatment below.

_CMT_HASH = {"bash", "gitignore", "yaml", "toml", "ini", "dockerfile"}

_WS_RE = re.compile(r"^[ \t]*")
_CODE_BLOCK_RE = re.compile(
    r'<div class="code-block" data-lang="([^"]*)">'
    r'<pre><code(?: class="language-[^"]*")?>(.*?)</code></pre></div>',
    re.S,
)
_HEADING_RE = re.compile(r'<h([23]) id="([^"]+)">(.*?)</h\1>', re.S)


def _cm(line: str) -> str:
    """Wrap a whole comment line in the graphite comment scope."""
    ws = _WS_RE.match(line).group(0)
    return f'{ws}<span class="cm">{line[len(ws):]}</span>'


def _colorize(code: str, lang: str) -> str:
    """Comment-only treatment for the languages highlight.py doesn't
    own — bash keeps its printed look: graphite comments, and the frame
    badge's green $ says how it runs."""
    if lang not in _CMT_HASH:
        return code
    out = []
    for line in code.split("\n"):
        out.append(_cm(line) if line.lstrip(" \t").startswith("#") else line)
    return "\n".join(out)


def _where(lang: str) -> str:
    """The frame-header badge: cause before effect — say WHERE code runs.
    Ember = server, arc = client; a ```pyxl fence is the whole file and
    says so (its halves genuinely run in both places)."""
    if lang == "pyxl":
        return (
            '<span class="where"><b>server</b> <i class="sep">+</i> '
            '<b class="cb">client</b> · one file</span>'
        )
    if lang == "python":
        return '<span class="where">runs on the <b>server</b></span>'
    if lang in ("jsx", "tsx"):
        return '<span class="where">runs on the <b class="cb">client</b></span>'
    if lang == "bash":
        return '<span class="where"><b>$</b> shell</span>'
    return '<span class="where"></span>'


def _unescape(code: str) -> str:
    """Reverse build-docs.mjs's renderer.code escaping (&, <, > — amp last)."""
    return code.replace("&lt;", "<").replace("&gt;", ">").replace("&amp;", "&")


def _frame(match: re.Match) -> str:
    # Root-module import, function-scoped per the house pattern (db.py,
    # emails.py); Python caches it, and _page_cache means each article
    # is transformed once per process anyway.
    from highlight import highlight_block

    lang, code = match.group(1), match.group(2)
    label = lang or "output"
    # A ```pyxl frame draws NOTHING at its Python/JSX boundary — the
    # blank line renders as a plain blank line and the badge alone
    # states one-file-ness. The boundary detection in highlight.py
    # serves tokenization only: each half carries the exact token
    # classes a separate ```python / ```jsx fence would emit.
    body = highlight_block(_unescape(code), lang)
    if body is None:
        body = _colorize(code, lang)
    return (
        f'<figure class="dcode frame" data-lang="{label}">'
        f'<figcaption class="fhd"><span class="nm">{label}</span>{_where(lang)}'
        f'<button class="cpb" type="button" data-copy>copy</button></figcaption>'
        f'<pre><code>{body}</code></pre></figure>'
    )


def _anchor(match: re.Match) -> str:
    depth, hid, inner = match.group(1), match.group(2), match.group(3)
    return (
        f'<h{depth} id="{hid}">{inner}'
        f'<a class="ha" href="#{hid}" aria-label="Link to section">#</a></h{depth}>'
    )


def _transform_body(html: str) -> str:
    # Tables scroll inside their own container, never the page.
    html = html.replace("<table>", '<div class="tw"><table>')
    html = html.replace("</table>", "</table></div>")
    # Code blocks → the homepage frame chrome (badge + copy button).
    html = _CODE_BLOCK_RE.sub(_frame, html)
    # Heading self-links.
    html = _HEADING_RE.sub(_anchor, html)
    return html


def _load_page(slug: str):
    """Load + transform one article, or ``None`` if it doesn't exist."""
    if slug in _page_cache:
        return _page_cache[slug]

    page_path = DOCS_DIR / f"{slug}.json"
    try:
        page_path = page_path.resolve(strict=False)
        page_path.relative_to(DOCS_DIR.resolve())
    except (ValueError, OSError):
        return None
    if not page_path.exists():
        return None

    raw = json.loads(page_path.read_text())
    _, meta_of, _ = _listing()
    meta = meta_of.get(raw["path"], {})

    def nav_ref(ref):
        if not ref:
            return None
        ref_meta = meta_of.get(ref["path"], {})
        return {"title": ref["title"], "path": ref["path"], "line": ref_meta.get("line")}

    page = {
        "title": raw["title"],
        "description": raw.get("description") or "",
        "path": raw["path"],
        "html": _transform_body(raw["html"]),
        "toc": raw.get("toc") or [],
        "markdown": raw.get("markdown") or "",
        "prev": nav_ref(raw.get("prev")),
        "next": nav_ref(raw.get("next")),
        "line": meta.get("line"),
        "catSlug": meta.get("cat") or raw["path"].split("/")[0],
    }
    _page_cache[slug] = page
    return page


@server
async def load_docs(request):
    slug = request.path_params.get("slug", "") or ""
    base = {"version": __version__, "slug": slug, "shelves": [], "total": 0}

    # A @server loader may return ``(payload, status_code)``. An unknown or
    # unsafe doc slug renders the in-page "Back to docs" 404 *and* returns a
    # real HTTP 404, so crawlers and link checkers see the right status.
    if not _is_safe_slug(slug):
        return {**base, "landing": False, "page": None, "notFound": True}, 404

    listing = _listing()
    if listing is None:
        # docs-data not generated (fresh checkout without build-docs). The
        # landing degrades to its empty state; article URLs are honestly 404.
        if not slug:
            return {**base, "landing": True, "page": None}
        return {**base, "landing": False, "page": None, "notFound": True}, 404
    shelves, _, total = listing
    base.update({"shelves": shelves, "total": total})

    if not slug:
        return {**base, "landing": True, "page": None}

    page = _load_page(slug)
    if page is None:
        return {**base, "landing": False, "page": None, "notFound": True}, 404
    return {**base, "landing": False, "page": page}


import '../styles/docs.css';
import React, { useCallback, useEffect, useMemo, useRef, useState } from 'react';
import { Link, navigate } from 'pyxle/client';
import { PageMeta } from '../components/page-meta.jsx';
import {
    NN, DocsMobileBarActions, DocsRail, DocsShelves, DocsTerms, DocsToc,
} from '../components/docs-chrome.jsx';
import { QuickOpen } from '../components/docs-quick-open.jsx';
import NotFoundContent from '../components/not-found-content.jsx';

const LANDING_DESC =
    'Pyxle documentation — every page of the manual, one listing. Getting '
    + 'started, core concepts, guides, reference, plugins, architecture.';

const DOCS_REPO = 'https://github.com/pyxle-dev/pyxle';

/* ── the mobile quick-action bar, docs edition ────────────────────
 * Fills the layout MobileBar's `m-bar` slot: on articles ▤ index
 * (the rail overlay) + ⌘K search; on the landing ⌘K search + a jump
 * to line 01. Slot factories get the page props, so this is SSR'd
 * with the right variant on both server and client. */
export const createSlots = (props) => {
    const data = props && props.data;
    if (!data || data.notFound) return {};
    const firstShelf = data.shelves && data.shelves[0];
    const first = firstShelf && firstShelf.items && firstShelf.items[0];
    return {
        'm-bar': () => (
            <DocsMobileBarActions
                landing={Boolean(data.landing)}
                firstPath={first ? first.path : null}
                firstLine={first ? first.line : 1}
            />
        ),
    };
};

/* ── article header actions — the AI-accessibility affordances ────
 * Every article is real Markdown one URL away; these keep that story
 * one keystroke away (labels, not sentences). */
function ArticleActions({ page }) {
    const [copied, setCopied] = useState(false);
    const timerRef = useRef(null);
    useEffect(() => () => clearTimeout(timerRef.current), []);

    const copyMd = useCallback(() => {
        if (typeof navigator === 'undefined' || !navigator.clipboard) return;
        const md = page.markdown || `# ${page.title}`;
        navigator.clipboard.writeText(md).then(() => {
            setCopied(true);
            clearTimeout(timerRef.current);
            timerRef.current = setTimeout(() => setCopied(false), 1400);
        }, () => {});
    }, [page]);

    // Point AI assistants at the clean Markdown rendition, not the HTML page.
    const mdUrl = `https://pyxle.dev/docs/${page.path}.md`;
    const aiPrompt = encodeURIComponent(
        `Read ${mdUrl} carefully so I can ask questions about it.\n\n`
        + 'Pyxle is a new Python-first full-stack framework, so you likely lack training data on it. '
        + 'Every page is available as Markdown by appending .md to its URL; the docs index is '
        + 'https://pyxle.dev/llms.txt and you can search with https://pyxle.dev/api/docs-search?q=YOUR+QUERY.',
    );

    return (
        <span className="acts">
            <button type="button" className="cpb" onClick={copyMd} title="Copy this page as Markdown">
                {copied ? 'copied' : 'copy md'}
            </button>
            <a className="cpb" href={`/docs/${page.path}.md`} target="_blank" rel="noreferrer" title="This page as Markdown">md ↗</a>
            <a className="cpb hide-m" href={`https://claude.ai/new?q=${aiPrompt}`} target="_blank" rel="noreferrer" title="Ask Claude about this page">claude ↗</a>
            <a className="cpb hide-m" href={`https://chatgpt.com/?q=${aiPrompt}`} target="_blank" rel="noreferrer" title="Ask ChatGPT about this page">gpt ↗</a>
            <a className="cpb hide-m" href={`${DOCS_REPO}/blob/main/docs/${page.path}.md`} target="_blank" rel="noreferrer" title="This page's source markdown on GitHub">src ↗</a>
            <span role="status" className="sr">{copied ? 'Copied page as Markdown' : ''}</span>
        </span>
    );
}

/* ── main page ────────────────────────────────────────────────────── */

export default function DocsPage({ data }) {
    const { slug, page, landing, notFound } = data;
    const shelves = data.shelves || [];
    const total = data.total || 0;

    const [qoOpen, setQoOpen] = useState(false);
    const [railOpen, setRailOpen] = useState(false);
    const [kbi, setKbi] = useState(-1); // j/k cursor into the flattened listing

    const bodyRef = useRef(null);

    /* The flattened listing — one array drives the rail, the shelves,
       j/k and the ⌘K palette, all in reading order. */
    const rows = useMemo(
        () => shelves.flatMap((s) => s.items.map((it) => ({ ...it, category: s.category }))),
        [shelves],
    );
    const kbPath = kbi >= 0 && rows[kbi] ? rows[kbi].path : null;

    /* Navigation resets transient chrome state. */
    useEffect(() => {
        setRailOpen(false);
        setKbi(-1);
    }, [slug]);

    /* The mobile rail overlay is CSS keyed on body.rail-open (the rail
       markup is always SSR'd); broadcast state so the m-bar slot's
       label can follow. */
    useEffect(() => {
        document.body.classList.toggle('rail-open', railOpen);
        window.dispatchEvent(new CustomEvent('pyxle:docs-rail', { detail: { open: railOpen } }));
        return () => document.body.classList.remove('rail-open');
    }, [railOpen]);

    /* Intent events from the m-bar slot (module scope can't reach here). */
    useEffect(() => {
        const toggleRail = () => setRailOpen((v) => !v);
        const openQo = () => setQoOpen(true);
        window.addEventListener('pyxle:docs-rail-toggle', toggleRail);
        window.addEventListener('pyxle:docs-qo', openQo);
        return () => {
            window.removeEventListener('pyxle:docs-rail-toggle', toggleRail);
            window.removeEventListener('pyxle:docs-qo', openQo);
        };
    }, []);

    /* Keyboard: ⌘K / ^K / "/" open the palette; j/k walk the listing,
       enter opens the highlighted line. Arrow keys join in while the
       mobile rail overlay is open. */
    useEffect(() => {
        function onKey(e) {
            const tag = (document.activeElement && document.activeElement.tagName) || '';
            const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(tag);
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                setQoOpen((v) => !v);
                return;
            }
            if (typing || e.metaKey || e.ctrlKey || e.altKey || qoOpen || notFound) return;
            if (e.key === '/') {
                e.preventDefault();
                setQoOpen(true);
                return;
            }
            if (e.key === 'j' || (e.key === 'ArrowDown' && railOpen)) {
                setKbi((i) => (i < 0
                    ? Math.max(0, rows.findIndex((r) => r.path === slug))
                    : Math.min(rows.length - 1, i + 1)));
            } else if (e.key === 'k' || (e.key === 'ArrowUp' && railOpen)) {
                setKbi((i) => (i < 0 ? 0 : Math.max(0, i - 1)));
            } else if (e.key === 'Enter' && kbi >= 0 && rows[kbi]) {
                navigate(`/docs/${rows[kbi].path}`);
            }
        }
        window.addEventListener('keydown', onKey);
        return () => window.removeEventListener('keydown', onKey);
    }, [qoOpen, railOpen, kbi, rows, slug, notFound]);

    /* Keep the j/k cursor line in view. */
    useEffect(() => {
        if (kbi < 0) return;
        const el = document.querySelector('.ri.kb');
        if (el) el.scrollIntoView({ block: 'nearest' });
    }, [kbi]);

    /* Code-frame copy buttons live inside the SSR'd article HTML —
       behaviour attaches by delegation after mount (the button text /
       .did flips are outside React's tree, so hydration never sees
       them). */
    useEffect(() => {
        const root = bodyRef.current;
        if (!root) return undefined;
        const timers = new Set();
        const onClick = (e) => {
            const btn = e.target.closest('[data-copy]');
            if (!btn) return;
            const frame = btn.closest('.dcode');
            const pre = frame && frame.querySelector('pre');
            if (!pre) return;
            const done = () => {
                btn.textContent = 'copied';
                btn.classList.add('did');
                const t = setTimeout(() => {
                    btn.textContent = 'copy';
                    btn.classList.remove('did');
                    timers.delete(t);
                }, 1400);
                timers.add(t);
            };
            if (navigator.clipboard) navigator.clipboard.writeText(pre.textContent).then(done, done);
            else done();
        };
        root.addEventListener('click', onClick);
        return () => {
            root.removeEventListener('click', onClick);
            timers.forEach(clearTimeout);
        };
    }, [slug, landing, notFound]);

    const openQo = useCallback(() => setQoOpen(true), []);
    const closeQo = useCallback(() => setQoOpen(false), []);

    return (
        <div id="top" className="docs-page">
            {notFound ? (
                <PageMeta title="Page not found" description={LANDING_DESC} path="/docs" />
            ) : landing ? (
                <PageMeta title="Docs" description={LANDING_DESC} path="/docs" />
            ) : (
                <PageMeta
                    title={page.title}
                    description={page.description || LANDING_DESC}
                    path={`/docs/${page.path}`}
                    type="article"
                />
            )}

            {notFound ? (
                <div className="flex flex-col" style={{ minHeight: 'calc(100vh - 56px)' }}>
                    <NotFoundContent
                        backHref="/docs"
                        backLabel="Back to docs"
                        sourceUrl="https://github.com/pyxle-dev/pyxle.dev/blob/main/pages/components/not-found-content.jsx"
                    />
                </div>
            ) : landing ? (
                <main className="frame">
                    <section className="dhead">
                        {/* the index's folio: the extent of the manual, in ghost ink */}
                        <span className="dfolio b b-flat" aria-hidden="true">{NN(total)}</span>
                        <p className="dtab b b-flat">Docs · {total} pages</p>
                        <h1 className="dtitle b">The whole manual, one&nbsp;listing.</h1>
                        <p className="receipt b" style={{ '--bd': '.1s' }}>
                            {total} pages · {shelves.length} sections · generated from pyxle/docs
                        </p>
                        <div className="dhint b" style={{ '--bd': '.18s' }}>
                            <button className="qbtn" type="button" onClick={openQo}>
                                <span className="pr" aria-hidden="true">⌘K</span> quick open{' '}
                                <span className="qk">or press /</span>
                            </button>
                            <span className="meta">j/k move · enter opens</span>
                        </div>
                    </section>
                    <DocsShelves shelves={shelves} kbPath={kbPath} />
                </main>
            ) : page && (
                <div className="frame">
                    <div className="dgrid">
                        <DocsRail
                            shelves={shelves}
                            currentPath={page.path}
                            kbPath={kbPath}
                            onSearch={openQo}
                        />
                        <article className="art">
                            <span className="artfolio" aria-hidden="true">{NN(page.line)}</span>
                            <div className="crumb">
                                <Link href="/docs">docs</Link>
                                <span className="sl">/</span>
                                <span>{page.catSlug}</span>
                                <ArticleActions page={page} />
                            </div>
                            <h1 className="atitle">{page.title}</h1>
                            <p className="receipt arec">
                                docs/{page.path}.md · line {NN(page.line)} of {NN(total)}
                            </p>
                            <div
                                className="body"
                                ref={bodyRef}
                                dangerouslySetInnerHTML={{ __html: page.html }}
                            />
                            <DocsTerms prev={page.prev} next={page.next} />
                        </article>
                        <DocsToc toc={page.toc} slug={slug} />
                    </div>
                </div>
            )}

            <QuickOpen open={qoOpen} onClose={closeQo} rows={rows} />
        </div>
    );
}
