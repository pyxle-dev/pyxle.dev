import './styles/f-benchmarks.css';
import React, { useCallback, useEffect, useRef, useState } from 'react';
import { Link } from 'pyxle/client';
import { PageMeta } from './components/e-meta.jsx';
import { Rulebar, Receipt, CopyChip, useSeen } from './components/f-kit.jsx';

/* ════════════════════════════════════════════════════════════════
   F — THE WORKING COPY · /benchmarks — the full datasheet.

   The homepage's F4 ("Numbers we can defend.") grown into a page:
   every benchmark is a FIG on a Deck plate, green bars are Pyxle's
   own measured runs, Faint bars are everyone else — including the
   figures we lose — and the test conditions are printed INSIDE each
   plate. No animated counters, no scroll scrub: bars draw once when
   a figure enters the viewport, and after that the page moves only
   when the visitor acts (endpoint tabs, the workers toggle).

   Every figure is the real measured number (req/s at 100 concurrent
   connections — two AWS c7i.2xlarge boxes: the seven frameworks on
   one, oha on the other, over the private network; native
   multi-process production mode at 8 workers, dynamic SSR per core;
   median of 3 reps). Measured July 2026 on Pyxle 0.7.1, straight
   from the raw oha JSON (benchmarks/results/0.7.1-run) — and NOT
   re-measured for the 0.9 line, which the page says plainly.

   Hydration law: the default state (form POST · Python only ·
   8 workers) is server-rendered and identical on the first client
   render; bar widths are deterministic inline styles; `.seen` starts
   false on both sides and flips post-mount.
   ════════════════════════════════════════════════════════════════ */

const RUN = 'July 2026 · median of 3 reps';
const HARNESS = 'https://github.com/pyxle-dev/benchmarks';
const REPRO_CMD = `git clone ${HARNESS} && cd benchmarks && ./bench.sh --suite=all --workers=auto`;
const fmt = (n) => n.toLocaleString('en-US');

/* ── data — byte-matched to the published 0.7.1 run ─────────────── */

const FW = {
    pyxle:   { name: 'Pyxle',   ver: 'Pyxle 0.7.1' },
    fastapi: { name: 'FastAPI', ver: 'FastAPI 0.139' },
    flask:   { name: 'Flask',   ver: 'Flask 3.1' },
    django:  { name: 'Django',  ver: 'Django 5.2' },
    express: { name: 'Express', ver: 'Express 5.2' },
    hono:    { name: 'Hono',    ver: 'Hono 4.12' },
    nextjs:  { name: 'Next.js', ver: 'Next.js 16.2' },
};
const PY_SET = ['pyxle', 'fastapi', 'flask', 'django'];
const ALL_SET = ['pyxle', 'fastapi', 'flask', 'django', 'express', 'hono', 'nextjs'];

const EP = {
    form: {
        label: 'form POST',
        desc: 'parse a JSON body · validate fields · respond — the request-processing pipeline',
        data: { pyxle: 52438, fastapi: 47125, django: 8576, flask: 21264, express: 42949, hono: 79278, nextjs: 7805 },
    },
    json: {
        label: 'JSON',
        desc: 'return a static JSON object — pure framework + serialization overhead',
        data: { pyxle: 59766, fastapi: 61565, django: 9126, flask: 23809, express: 53164, hono: 212528, nextjs: 8854 },
    },
    health: {
        label: 'health check',
        desc: 'a minimal endpoint — raw routing overhead',
        data: { pyxle: 59785, fastapi: 63040, django: 9138, flask: 24094, express: 54058, hono: 214692, nextjs: 8953 },
    },
    db: {
        label: '1 DB query',
        desc: 'one random SQLite row, persistent per-worker connection — the driver dominates, not the framework',
        data: { pyxle: 29299, fastapi: 32319, django: 6970, flask: 21382, express: 47937, hono: 172870, nextjs: 8667 },
    },
    q5: {
        label: '5 queries',
        desc: 'five random SQLite rows — query-loop performance',
        data: { pyxle: 24681, fastapi: 22013, django: 6298, flask: 18286, express: 41031, hono: 105988, nextjs: 8121 },
    },
    q20: {
        label: '20 queries',
        desc: 'twenty random SQLite rows — the query loop dominates',
        data: { pyxle: 15569, fastapi: 11862, django: 5432, flask: 14213, express: 26205, hono: 34547, nextjs: 7601 },
    },
};

// Dynamic SSR — the full page re-rendered per request, per core
// (a separate single-worker pass isolates true render efficiency).
const SSR = [
    { key: 'landing',  page: 'Landing page',        detail: 'hero, feature grid, stats — a typical marketing home', p: { rps: 1151,  p50: 84 },  n: { rps: 524,  p50: 183 },  x: '2.20' },
    { key: 'table',    page: '300-row data table',  detail: 'a large inventory table, fully server-rendered',       p: { rps: 158,   p50: 644 }, n: { rps: 75,   p50: 1344 }, x: '2.11' },
    { key: 'dash',     page: 'Nested dashboard',    detail: 'stat cards, grouped category cards, and a data table', p: { rps: 237,   p50: 419 }, n: { rps: 103,  p50: 983 },  x: '2.30' },
    { key: 'apiroute', page: 'API route, same app', detail: 'a JSON endpoint served through each full SSR app',     p: { rps: 11784, p50: 8 },   n: { rps: 2149, p50: 45 },   x: '5.48' },
];

// Same app, same box — the only change is `pyxle serve --workers 8`.
const SCALE = [
    { test: 'JSON serialization', one: 11820, eight: 59766, x: '5.1×' },
    { test: 'Form POST',          one: 10705, eight: 52438, x: '4.9×' },
    { test: 'Single DB query',    one: 3816,  eight: 29299, x: '7.7×' },
    { test: 'Five-query page',    one: 1961,  eight: 24681, x: '12.6×' },
];

// Bytes on the wire — same DOM, per response (per-request pages only).
const BYTES = [
    { page: 'Landing page',       detail: 'whole HTML document, per response', pv: '5.4 KB',  nv: '13.7 KB', pct: 39.4 },
    { page: '300-row data table', detail: 'the table page, fully rendered',    pv: '145 KB',  nv: '332 KB',  pct: 43.7 },
];

// pyxle.dev's actual production desktop Lighthouse scores.
const LH = [
    ['100', 'Performance'], ['100', 'Accessibility'], ['100', 'Best Practices'], ['100', 'SEO'],
];

/* the printed contents — six findings, each a row in the index */
const TOC = [
    ['#ssr',     '01', '~2.2×',  'Next.js dynamic-SSR throughput, per core — the cross-ecosystem reference'],
    ['#field',   '02', '±3%',    'parity with FastAPI on JSON — ahead once real work appears'],
    ['#scaling', '03', '~5×',    'more throughput with one flag — pyxle serve --workers 8'],
    ['#losses',  '04', 'Hono',   'owns raw JSON — a Node ultralight, and we say so'],
    ['#bytes',   '05', '2–3×',   'smaller HTML for the same DOM — no hydration blob'],
    ['#method',  '06', '0',      'errors, timeouts, or non-2xx across the whole suite'],
];

/* ── shared figure furniture ─────────────────────────────────────── */

/* $ reproduce — every figure carries the real harness command */
function ReproChip() {
    const [copied, setCopied] = useState(false);
    const timerRef = useRef(null);
    useEffect(() => () => clearTimeout(timerRef.current), []);
    const go = useCallback(() => {
        const done = () => {
            setCopied(true);
            clearTimeout(timerRef.current);
            timerRef.current = setTimeout(() => setCopied(false), 1400);
        };
        if (typeof navigator !== 'undefined' && navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(REPRO_CMD).then(done, done);
        } else done();
    }, []);
    return (
        <button type="button" className={`bm-repro${copied ? ' copied' : ''}`} onClick={go}>
            <span className="d" aria-hidden="true">$</span> reproduce · {copied ? 'copied' : 'copy'}
            <span role="status" className="sr">{copied ? 'Copied to clipboard' : ''}</span>
        </button>
    );
}

function Plate({ tag, children }) {
    return (
        <figure className="bm-plate">
            <div className="bm-plate-head">
                <span className="bm-plate-tag">{tag}</span>
                <ReproChip />
            </div>
            {children}
        </figure>
    );
}

function BarRow({ label, me, pct, value, sub, scale }) {
    return (
        <p className={`bm-row${me ? ' me' : ''}${scale ? ' bm-scale-row' : ''}`}>
            <span className="fn">{label}</span>
            <span className="bm-track"><span className={`bm-bar ${me ? 'bm-bar-g' : 'bm-bar-k'}`} style={{ '--w': `${pct}%` }} /></span>
            <span className="fv">{value}{sub ? <i> · {sub}</i> : null}</span>
        </p>
    );
}

/* ── hero — the datasheet's cover: claim, conditions, contents ───── */

function Hero() {
    /* the hero's running head is visible from the start (f.js law) */
    const [ref, seen] = useSeen({ immediate: true });
    return (
        <section ref={ref} className={`sec bm-hero${seen ? ' seen' : ''}`} id="top">
            <div className="frame">
                <Rulebar hero tab="Benchmarks · The datasheet" />
                <div className="bm-hero-head">
                    <h1 className="b" style={{ '--bd': '.05s' }}>Numbers we can defend.</h1>
                    <Receipt className="b" style={{ '--bd': '.16s' }}>
                        every figure below carries its own test conditions · measured July 2026
                        on Pyxle 0.7.1 · not re-measured for the 0.9 line
                    </Receipt>
                    <nav className="bm-contents b" style={{ '--bd': '.28s' }} aria-label="Findings">
                        {TOC.map(([href, n, v, l]) => (
                            <a key={n} className="bm-toc" href={href}>
                                <span className="n">{n}</span>
                                <span className="v">{v}</span>
                                <span className="l">{l}</span>
                                <span className="g2">read <span className="a">→</span></span>
                            </a>
                        ))}
                    </nav>
                </div>
            </div>
        </section>
    );
}

/* ── 01 · SSR — the cross-ecosystem reference ────────────────────── */

function SsrSection() {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-ssr${seen ? ' seen' : ''}`} id="ssr">
            <div className="frame">
                <Rulebar tab="01 · SSR" href="#ssr" folio="01" />
                <div className="sec-head rv">
                    <h2>The SSR reference.</h2>
                    <Receipt>the full page, re-rendered per request · per core · the JS incumbent, for scale</Receipt>
                </div>
                <div className="rv" style={{ '--rvd': '.08s' }}>
                    <Plate tag="FIG 01 · dynamic SSR throughput, per core">
                        <div className="bm-pairs">
                            {SSR.map((s) => (
                                <div key={s.key} className="bm-pair">
                                    <p className="bm-pair-h">
                                        <span className="pg">{s.page}</span>
                                        <span className="dt">{s.detail}</span>
                                        <span className="dx">{s.x}×</span>
                                    </p>
                                    <BarRow me label="pyxle" pct={100} value={`${fmt(s.p.rps)} req/s`} sub={`p50 ${fmt(s.p.p50)} ms`} />
                                    <BarRow label="next.js" pct={Number(((s.n.rps / s.p.rps) * 100).toFixed(1))} value={`${fmt(s.n.rps)} req/s`} sub={`p50 ${fmt(s.n.p50)} ms`} />
                                </div>
                            ))}
                        </div>
                        <figcaption className="bm-cond">
                            <b>conditions</b> — Pyxle 0.7.1 (Starlette 0.37.2) vs Next.js 16.2 (React 19.2),
                            force-dynamic · single worker per core pass · 100 connections · {RUN} ·
                            parity-verified DOM · roughly half the median latency at every page complexity
                        </figcaption>
                    </Plate>
                </div>
            </div>
        </section>
    );
}

/* ── 02 · the field — Pyxle among the Python frameworks ──────────── */

function FieldSection() {
    const [ref, seen] = useSeen();
    const [ep, setEp] = useState('form');
    const [all, setAll] = useState(false);
    const e = EP[ep];
    const set = (all ? ALL_SET : PY_SET).slice().sort((a, b) => e.data[b] - e.data[a]);
    const max = e.data[set[0]];
    return (
        <section ref={ref} className={`sec sec-field${seen ? ' seen' : ''}`} id="field">
            <div className="frame">
                <Rulebar tab="02 · The field" href="#field" folio="02" />
                <div className="sec-head rv">
                    <h2>The Python field first.</h2>
                    <Receipt>identical endpoints, parity-verified · 8 workers · 100 connections · req/s, higher is better</Receipt>
                </div>
                <div className="rv" style={{ '--rvd': '.08s' }}>
                    <Plate tag="FIG 02 · identical endpoints, side by side">
                        <div className="bm-tabs" role="tablist" aria-label="Endpoint">
                            {Object.entries(EP).map(([key, t]) => (
                                <button key={key} type="button" className="bm-tab" aria-pressed={ep === key} onClick={() => setEp(key)}>
                                    {t.label}
                                </button>
                            ))}
                        </div>
                        <p className="bm-epdesc">{e.desc}</p>
                        <div className="bm-rows">
                            {set.map((k) => {
                                const v = e.data[k];
                                return (
                                    <BarRow
                                        key={k}
                                        me={k === 'pyxle'}
                                        label={FW[k].name}
                                        pct={Number(((v / max) * 100).toFixed(1))}
                                        value={fmt(v)}
                                    />
                                );
                            })}
                        </div>
                        <div className="bm-tabs" style={{ marginTop: 26, marginBottom: 0, borderBottom: 0 }} role="group" aria-label="Framework set">
                            <button type="button" className="bm-tab" aria-pressed={!all} onClick={() => setAll(false)}>Python only</button>
                            <button type="button" className="bm-tab" aria-pressed={all} onClick={() => setAll(true)}>+ the JS row, for scale</button>
                        </div>
                        <figcaption className="bm-cond">
                            <b>the reading</b> — JSON: parity with FastAPI (±3%) · health ping: ~5% behind ·
                            form POST and the multi-query pages: ahead · single-row read: ~10% behind —
                            and Pyxle carries its full middleware stack (SSR · gzip · server actions) in every run ·
                            versions in <a className="link" href="#method">the method</a> · {RUN}
                        </figcaption>
                    </Plate>
                </div>
            </div>
        </section>
    );
}

/* ── 03 · scaling — one flag, every core ─────────────────────────── */

function ScalingSection() {
    const [ref, seen] = useSeen();
    const [eight, setEight] = useState(true); /* static-complete default: 8 workers */
    const MAX = 59766;
    return (
        <section ref={ref} className={`sec sec-scaling${seen ? ' seen' : ''}`} id="scaling">
            <div className="frame">
                <Rulebar tab="03 · Scaling" href="#scaling" folio="03" />
                <div className="sec-head rv">
                    <h2>One flag, every core.</h2>
                    <Receipt>same app, same 8-core box · no load balancer, no shared state — an independent process per core</Receipt>
                </div>
                <div className="rv" style={{ '--rvd': '.08s' }}>
                    <Plate tag="FIG 03 · workers 1 → 8">
                        <div className="bm-tabs" role="group" aria-label="Worker count">
                            <button type="button" className="bm-tab" aria-pressed={!eight} onClick={() => setEight(false)}>
                                <span className="d" aria-hidden="true">$</span> pyxle serve --workers 1
                            </button>
                            <button type="button" className="bm-tab" aria-pressed={eight} onClick={() => setEight(true)}>
                                <span className="d" aria-hidden="true">$</span> pyxle serve --workers 8
                            </button>
                        </div>
                        <div className="bm-rows">
                            {SCALE.map((d) => {
                                const v = eight ? d.eight : d.one;
                                return (
                                    <BarRow
                                        key={d.test}
                                        me
                                        scale
                                        label={d.test}
                                        pct={Number(((v / MAX) * 100).toFixed(1))}
                                        value={fmt(v)}
                                        sub={eight ? <span className="fx-m">{d.x}</span> : '1 worker'}
                                    />
                                );
                            })}
                        </div>
                        <figcaption className="bm-cond">
                            <b>the reading</b> — mean 9.0× across the six API tests; FastAPI does 7.4× on the
                            same move · multi-query passes 8× because one worker serializes its blocking
                            SQLite reads and eight overlap them · per core the optimized Node runtimes
                            still lead · requires Pyxle 0.4.3+ · {RUN}
                        </figcaption>
                    </Plate>
                </div>
            </div>
        </section>
    );
}

/* ── 04 · losses — a benchmark page that only shows wins is an ad ── */

function LossesSection() {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-losses${seen ? ' seen' : ''}`} id="losses">
            <div className="frame">
                <Rulebar tab="04 · Losses" href="#losses" folio="04" />
                <div className="sec-head rv">
                    <h2>Where Pyxle loses.</h2>
                    <Receipt>a benchmark page that only shows wins is an ad · same boxes, same run</Receipt>
                </div>
                <div className="bm-losses">
                    <div className="rv" style={{ '--rvd': '.08s' }}>
                        <Plate tag="FIG 04 · raw JSON — nothing to render">
                            <div className="bm-rows">
                                <BarRow label="Hono" pct={100} value="212,528" />
                                <BarRow label="FastAPI" pct={29.0} value="61,565" />
                                <BarRow me label="Pyxle" pct={28.1} value="59,766" />
                            </div>
                            <figcaption className="bm-cond">
                                Hono — an ultralight with no SSR — is ~3.5× ahead, and FastAPI edges Pyxle
                                by a few percent on JSON and the bare health ping · the off-box generator
                                is what keeps this gap visible · {RUN}
                            </figcaption>
                        </Plate>
                    </div>
                    <div className="rv" style={{ '--rvd': '.16s' }}>
                        <Plate tag="FIG 05 · single DB read — one random row">
                            <div className="bm-rows">
                                <BarRow label="Hono" pct={100} value="172,870" />
                                <BarRow label="Express" pct={27.7} value="47,937" />
                                <BarRow label="FastAPI" pct={18.7} value="32,319" />
                                <BarRow me label="Pyxle" pct={16.9} value="29,299" />
                            </div>
                            <figcaption className="bm-cond">
                                native better-sqlite3 bindings own the single read, and FastAPI leads by
                                ~10% · add real work and it flips: Pyxle 24,681 vs FastAPI 22,013 on the
                                five-query page · {RUN}
                            </figcaption>
                        </Plate>
                    </div>
                </div>
            </div>
        </section>
    );
}

/* ── 05 · bytes — the same DOM, weighed ──────────────────────────── */

function BytesSection() {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-bytes${seen ? ' seen' : ''}`} id="bytes">
            <div className="frame">
                <Rulebar tab="05 · Bytes" href="#bytes" folio="05" />
                <div className="sec-head rv">
                    <h2>Same DOM, fewer bytes.</h2>
                    <Receipt>HTML per response, per-request pages only — static content caches equally on both</Receipt>
                </div>
                <div className="rv" style={{ '--rvd': '.08s' }}>
                    <Plate tag="FIG 06 · bytes on the wire — lower is better">
                        <div className="bm-pairs">
                            {BYTES.map((b) => (
                                <div key={b.page} className="bm-pair">
                                    <p className="bm-pair-h">
                                        <span className="pg">{b.page}</span>
                                        <span className="dt">{b.detail}</span>
                                        <span className="dx">{Math.round(b.pct)}% the bytes</span>
                                    </p>
                                    <BarRow me label="pyxle" pct={b.pct} value={b.pv} />
                                    <BarRow label="next.js" pct={100} value={b.nv} sub="includes the RSC hydration payload" />
                                </div>
                            ))}
                        </div>
                        <figcaption className="bm-cond">
                            <b>conditions</b> — equivalent SSR DOM, verified before the run · production
                            builds · measured July 2026 · the difference is the hydration blob Pyxle
                            never ships
                        </figcaption>
                    </Plate>
                </div>
            </div>
        </section>
    );
}

/* ── 06 · method — how the numbers were made ─────────────────────── */

const METHOD_ROWS = [
    ['protocol', '12 s per test · 8 s warm-up · median of 3 reps'],
    ['parity', 'identical JSON shape + equivalent SSR DOM, verified before every run — or the run aborts'],
    ['database', 'SQLite (WAL) · 1,000 pre-seeded rows · persistent per-worker connection'],
    ['per-core pass', 'a separate single-worker pass measures per-core throughput'],
    ['correctness', '0 errors · 0 non-2xx · 0 timeouts across the suite'],
    ['versions', 'Pyxle 0.7.1 (Starlette 0.37.2) · Hono 4.12 · Express 5.2 · Next.js 16.2 (React 19.2) · FastAPI 0.139 · Django 5.2 · Flask 3.1 · Node 22.23'],
    ['servers', 'pyxle serve --workers 8 (full middleware) · uvicorn+uvloop · gunicorn · Node cluster · 8× next start'],
    ['the 0.9 line', 'not re-measured — a real 0.7.1 figure, said plainly, over an estimate'],
];

function MethodSection() {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-method${seen ? ' seen' : ''}`} id="method">
            <div className="frame">
                <Rulebar tab="06 · Method" href="#method" folio="06" />
                <div className="sec-head rv">
                    <h2>How the numbers were made.</h2>
                    <Receipt>two boxes, one job each — the load generator is never the ceiling</Receipt>
                </div>
                <div className="bm-boxes rv" style={{ '--rvd': '.08s' }}>
                    <div className="bm-box">
                        <b>server box · c7i.2xlarge</b>
                        8 vCPU · 8 workers · the framework under test, in native multi-process production mode
                    </div>
                    <div className="bm-wire" aria-hidden="true" />
                    <div className="bm-box">
                        <b>generator box · c7i.2xlarge</b>
                        oha v1.14 · 100 connections · off-box over the private network
                    </div>
                </div>
                <div className="bm-facts rv" style={{ '--rvd': '.14s' }}>
                    {METHOD_ROWS.map(([k, v]) => (
                        <p key={k} className="bm-fact"><span className="fk">{k}</span><span className="fv">{v}</span></p>
                    ))}
                    <p className="bm-fact">
                        <span className="fk">harness</span>
                        <span className="fv">
                            <a className="link" href={HARNESS} target="_blank" rel="noreferrer">github.com/pyxle-dev/benchmarks <span className="a">→</span></a>
                            {' '}— endpoint implementations, the Next.js apps, parity checks, raw runs
                        </span>
                    </p>
                </div>
            </div>
        </section>
    );
}

/* ── 07 · real world — this site is its own benchmark ────────────── */

function RealWorldSection() {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-real${seen ? ' seen' : ''}`} id="real">
