}

/* ── 08 · reproduce — run them yourself ──────────────────────────── */

function ReproduceSection() {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-reproduce${seen ? ' seen' : ''}`} id="reproduce">
            <div className="frame">
                <Rulebar tab="08 · Reproduce" href="#reproduce" folio="08" />
                <div className="sec-head rv">
                    <h2>Run them yourself.</h2>
                    <Receipt>the harness, the apps, the parity checks — all in the repo</Receipt>
                </div>
                <div className="bm-cmds rv" style={{ '--rvd': '.08s' }}>
                    <CopyChip text={`git clone ${HARNESS}`} />
                    <CopyChip text="cd benchmarks && ./bench.sh --suite=all --workers=auto" />
                </div>
                <div className="bm-facts rv" style={{ marginTop: 30, '--rvd': '.14s' }}>
                    <p className="bm-fact"><span className="fk">quick run</span><span className="fv">generator on your machine — fine for relative standings; absolute numbers read low</span></p>
                    <p className="bm-fact"><span className="fk">published flow</span><span className="fv">two boxes: ./bench.sh --serve-only --workers=auto · ./bench.sh --generate-only --target=&lt;server-ip&gt; --suite=all</span></p>
                    <p className="bm-fact"><span className="fk">in the repo</span><span className="fv">endpoint implementations · the Next.js apps · parity checks · SSR test pages · step-by-step README</span></p>
                </div>
                <p className="bm-exits rv" style={{ '--rvd': '.2s' }}>
                    <a className="link" href={HARNESS} target="_blank" rel="noreferrer">view benchmark source <span className="a">→</span></a>
                    <Link className="link" href="/compare">how this compares <span className="a">→</span></Link>
                    <Link className="link" href="/docs">read the docs <span className="a">→</span></Link>
                </p>
            </div>
        </section>
    );
}

/* ── page ────────────────────────────────────────────────────────── */

export default function BenchmarksPage() {
    return (
        <>
            <PageMeta
                title="Benchmarks"
                description="The datasheet: Pyxle in the Python field — FastAPI, Django, Flask — plus the SSR reference against Next.js. Off-box load generation, measured July 2026 on Pyxle 0.7.1; the losses printed next to the wins."
                path="/benchmarks"
            />
            <main id="main">
                <Hero />
                <SsrSection />
                <FieldSection />
                <ScalingSection />
                <LossesSection />
                <BytesSection />
                <MethodSection />
                <RealWorldSection />
                <ReproduceSection />
            </main>
        </>
    );
}
