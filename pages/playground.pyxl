from pyxle import __version__
from pyxle.runtime import ActionError

VALID_EMOJIS = ["heart", "fire", "mind_blown", "rocket", "sparkles", "clap"]


@server
async def load_playground(request):
    from db import get_reactions, increment_playground_views

    views = await increment_playground_views()
    reactions = await get_reactions()

    return {
        "totalViews": views,
        "reactions": reactions,
        "version": __version__,
    }


@action
async def react_emoji(request):
    from db import check_rate_limit, get_client_ip, increment_reaction

    client_ip = get_client_ip(request)
    # 5 reactions per hour per IP, scoped to the playground reactions board.
    if not await check_rate_limit(client_ip, scope="react_emoji"):
        raise ActionError(
            "Rate limit reached. Please try again after 1 hour.",
            status_code=429,
        )

    body = await request.json()
    emoji = body.get("emoji", "")
    if emoji not in VALID_EMOJIS:
        raise ActionError("Invalid reaction", status_code=400)

    new_count = await increment_reaction(emoji)
    return {"ok": True, "emoji": emoji, "count": new_count}


import './styles/f-playground.css';
import React, { useCallback, useRef, useState } from 'react';
import { Link, useAction } from 'pyxle/client';
import { PageMeta } from './components/e-meta.jsx';
import { Rulebar, Receipt, CopyChip, useSeen } from './components/f-kit.jsx';
import { GITHUB } from './components/f-chrome.jsx';
import { tokenizeBlock } from './components/code-highlighter.jsx';
import { LivePlayground, DEFAULT_SOURCE } from './components/live-playground.jsx';

/* ════════════════════════════════════════════════════════════════
   F — THE WORKING COPY · /playground — the copy, powered on.

   The sandbox machinery (live-playground.jsx + the opaque-origin
   Pyodide iframe) is UNCHANGED — only the shell wears F: the editor
   pane is the specimen (the page's one Ink border), example files
   sit as tabs ON a rule, and beneath the bench a quoted Terminal
   log prints only what actually happened — an engine boot, a
   re-run, an error. Section 02 taps this page's real @action over
   real HTTP; its log's 200s are the genuine article (green job 3).

   Motion is diegetic only: rows land when real events fire, the
   result pane flashes when a run completes (green job 6), the LIVE
   dot breathes only while the sandbox is rendering. Nothing loops,
   nothing scrubs, and prefers-reduced-motion kills all of it.
   ════════════════════════════════════════════════════════════════ */

/* ── Runnable examples (each runs in the isolated in-browser sandbox) ─ */

// The counter is the LivePlayground default. Reuse that exact source so the
// zero-Pyodide JS preview (which shows only while source === DEFAULT_SOURCE)
// also covers this page's initial counter tab — no boot until the user edits.
const EX_COUNTER = DEFAULT_SOURCE;

const EX_LOADER = `# greeting.pyxl

# @server runs on the server and returns a dict —
# it becomes your React props. No fetch, no API route.
@server
async def load(request):
    stack = ["Python", "React", "Starlette", "Vite"]
    return {
        "title": "Loaded by @server",
        "stack": stack,
        "count": len(stack),
    }


import React from 'react';

export default function Page({ data }) {
    return (
        <div className="card">
            <span className="tag">{data.count} items · from @server</span>
            <h1>{data.title}</h1>
            <ul>
                {data.stack.map((item, i) => (
                    <li key={i}>{item}</li>
                ))}
            </ul>
        </div>
    );
}`;

const EX_TODO = `# todo.pyxl

# The list lives in Python. Each @action mutates it
# on the server and returns the new state.
todos = [
    {"id": 1, "text": "Try the playground", "done": True},
    {"id": 2, "text": "Build a real feature", "done": False},
]
_next_id = 3

@server
async def load(request):
    return {"todos": todos}

@action
async def toggle(request):
    body = await request.json()
    for t in todos:
        if t["id"] == body["id"]:
            t["done"] = not t["done"]
    return {"todos": todos}

@action
async def add(request):
    global _next_id
    body = await request.json()
    todos.append({"id": _next_id, "text": body["text"], "done": False})
    _next_id += 1
    return {"todos": todos}


import React, { useState } from 'react';
import { useAction } from 'pyxle/client';

export default function Todo({ data }) {
    const [todos, setTodos] = useState(data.todos);
    const [text, setText] = useState('');
    const toggle = useAction('toggle');
    const add = useAction('add');

    async function onToggle(id) {
        const r = await toggle({ id });
        if (r.ok) setTodos(r.todos);
    }
    async function onAdd() {
        if (!text.trim()) return;
        const r = await add({ text });
        if (r.ok) { setTodos(r.todos); setText(''); }
    }

    return (
        <div className="card">
            <span className="tag">state on the server</span>
            <h1>Todos</h1>
            <ul>
                {todos.map((t) => (
                    <li key={t.id} onClick={() => onToggle(t.id)} style={{ cursor: 'pointer' }}>
                        {t.done ? '✓ ' : '○ '}{t.text}
                    </li>
                ))}
            </ul>
            <input value={text} onChange={(e) => setText(e.target.value)} placeholder="New todo…" />
            <button onClick={onAdd}>Add todo</button>
        </div>
    );
}`;

const EX_FORM = `# signup.pyxl

# @action validates on the server and raises
# ActionError — useAction surfaces it on the client.
from pyxle.runtime import ActionError

@server
async def load(request):
    return {}

@action
async def signup(request):
    body = await request.json()
    email = (body.get("email") or "").strip()
    if "@" not in email:
        raise ActionError("Please enter a valid email.")
    return {"message": f"Welcome aboard, {email}!"}


import React, { useState } from 'react';
import { useAction } from 'pyxle/client';

export default function Signup({ data }) {
    const [email, setEmail] = useState('');
    const [msg, setMsg] = useState(null);
    const signup = useAction('signup');

    async function onSubmit() {
        const r = await signup({ email });
        setMsg(r.ok ? r.message : r.error);
    }

    return (
        <div className="card">
            <span className="tag">validated on the server</span>
            <h1>Join the list</h1>
            <input value={email} onChange={(e) => setEmail(e.target.value)} placeholder="you@example.com" />
            <button onClick={onSubmit} disabled={signup.pending}>
                {signup.pending ? 'Submitting…' : 'Sign up'}
            </button>
            {msg && <p>{msg}</p>}
        </div>
    );
}`;

/* Zero-Pyodide JS mirrors of each example's rendered output — shown until
   the user edits the code (then the real sandbox boots and takes over).
   Each mirrors its EX_* component's markup + simulates the @server/@action
   behavior in plain JS, so switching examples never costs a boot. The
   counter reuses live-playground's built-in DefaultPreview (default source).
   These render inside .preview-scope — the surface that depicts a USER'S
   app, not pyxle.dev. */
function LoaderPreview() {
    const stack = ['Python', 'React', 'Starlette', 'Vite'];
    return (
        <div className="card">
            <span className="tag">{stack.length} items · from @server</span>
            <h1>Loaded by @server</h1>
            <ul>
                {stack.map((item, i) => <li key={i}>{item}</li>)}
            </ul>
        </div>
    );
}

function TodoPreview() {
    const [todos, setTodos] = useState([
        { id: 1, text: 'Try the playground', done: true },
        { id: 2, text: 'Build a real feature', done: false },
    ]);
    const [text, setText] = useState('');
    const [nextId, setNextId] = useState(3);
    const toggle = (id) => setTodos((ts) => ts.map((t) => (t.id === id ? { ...t, done: !t.done } : t)));
    const add = () => {
        if (!text.trim()) return;
        setTodos((ts) => [...ts, { id: nextId, text, done: false }]);
        setNextId((n) => n + 1);
        setText('');
    };
    return (
        <div className="card">
            <span className="tag">state on the server</span>
            <h1>Todos</h1>
            <ul>
                {todos.map((t) => (
                    <li key={t.id} onClick={() => toggle(t.id)} style={{ cursor: 'pointer' }}>
                        {t.done ? '✓ ' : '○ '}{t.text}
                    </li>
                ))}
            </ul>
            <input value={text} onChange={(e) => setText(e.target.value)} placeholder="New todo…" />
            <button type="button" onClick={add}>Add todo</button>
        </div>
    );
}

function FormPreview() {
    const [email, setEmail] = useState('');
    const [msg, setMsg] = useState(null);
    const submit = () => {
        const e = email.trim();
        setMsg(e.includes('@') ? `Welcome aboard, ${e}!` : 'Please enter a valid email.');
    };
    return (
        <div className="card">
            <span className="tag">validated on the server</span>
            <h1>Join the list</h1>
            <input value={email} onChange={(e) => setEmail(e.target.value)} placeholder="you@example.com" />
            <button type="button" onClick={submit}>Sign up</button>
            {msg && <p>{msg}</p>}
        </div>
    );
}

const EXAMPLES = [
    { id: 'counter', file: 'counter.pyxl', blurb: '@action + state', source: EX_COUNTER },
    { id: 'loader', file: 'greeting.pyxl', blurb: '@server → props', source: EX_LOADER, preview: LoaderPreview },
    { id: 'todo', file: 'todo.pyxl', blurb: 'multiple @actions', source: EX_TODO, preview: TodoPreview },
    { id: 'form', file: 'signup.pyxl', blurb: 'ActionError validation', source: EX_FORM, preview: FormPreview },
];

/* ── the log row — one quoted line, written by real events only ────
   Same classes as f-kit's <LogLine> (the Terminal-bed idiom), plus
   this page's one extension: the sandbox reports `ok`, not an HTTP
   200 — and a run that really completed earns the same green
   (job 3). `err` stays dim: code that failed never ran. */
function PgRow({ m, p, s, ms, tail, fresh }) {
    const ran = s === '200' || s === 'ok';
    return (
        <p className={`log-line${fresh ? ' fresh-log' : ''}`}>
            <span className="lg-m">{m}</span>
            <span className="lg-p">{p}</span>
            <span className={`lg-s${ran ? '' : ' lg-4xx'}`}>{s || ''}</span>
            <span className="lg-ms">{ms || ''}</span>
            <span className="lg-c">{tail || ''}</span>
        </p>
    );
}

/* ── 01 · SANDBOX — the bench: tabs on a rule · editor · result · log ─ */

function SandboxSection() {
    const [i, setI] = useState(0);
    const [rows, setRows] = useState([]);
    const [engineState, setEngineState] = useState('idle'); // idle|booting|live|offline
    const bootT0 = useRef(0);
    const keyRef = useRef(0);
    const fileRef = useRef(EXAMPLES[0].file);
    fileRef.current = EXAMPLES[i].file;
    const ex = EXAMPLES[i];

    /* Rows are written by real runtime events only, newest last, max 8
       kept, exactly one row fresh at a time. */
    const pushRow = useCallback((row) => {
        keyRef.current += 1;
        const key = keyRef.current;
        setRows((rs) => [
            ...rs.map((r) => (r.fresh ? { ...r, fresh: false } : r)).slice(-7),
            { ...row, key, fresh: true },
        ]);
    }, []);

    const onEngineEvent = useCallback((ev) => {
        if (ev.type === 'boot') {
            bootT0.current = performance.now();
            setEngineState('booting');
            pushRow({ m: 'BOOT', p: 'cpython · pyodide · ~12 MB once', ms: '···' });
        } else if (ev.type === 'status') {
            if (ev.status === 'ready') {
                setEngineState('live');
                const secs = ((performance.now() - bootT0.current) / 1000).toFixed(1);
                pushRow({ m: 'BOOT', p: 'cpython ready — real Python from here', s: 'ok', ms: `${secs} s` });
            } else if (ev.status === 'failed') {
                setEngineState('offline');
                pushRow({ m: 'ERR', p: 'runtime failed to load — the JS mirror stays', s: 'err' });
            } else if (ev.status === 'timeout') {
                pushRow({ m: 'ERR', p: 'runaway code stopped — edit to re-run', s: 'err' });
            }
        } else if (ev.type === 'ran') {
            if (ev.ok) {
                pushRow({
                    m: 'RUN',
                    p: `${fileRef.current} → load() → props → render`,
                    s: 'ok',
                    ms: ev.ms != null ? `${ev.ms} ms` : '',
                });
            } else {
                pushRow({ m: 'ERR', p: `${fileRef.current} — the result pane shows the error`, s: 'err' });
            }
        }
    }, [pushRow]);

    const selectExample = (idx) => {
        if (idx === i) return;
        setI(idx);
        if (engineState !== 'idle') {
            const next = EXAMPLES[idx];
            pushRow({ m: 'FILE', p: `${next.file} · ${next.blurb}` });
        }
    };

    return (
        <section className="sec sec-sandbox" id="sandbox">
            <div className="frame">
                <Rulebar hero tab="01 · Sandbox" href="#sandbox" />
                <div className="pg-head">
                    <h1 className="b" style={{ '--bd': '.05s' }}>The working copy, powered&nbsp;on.</h1>
                    <Receipt className="b" style={{ '--bd': '.2s' }}>
                        edit the file below — the actual Pyxle parser and real CPython re-run it in this tab
                    </Receipt>
                    <div className="pg-gate b" style={{ '--bd': '.32s' }}>
                        <span><span className="k">CPython</span> via Pyodide · ~12 MB once</span>
                        <span><span className="k">⌘/Ctrl + Enter</span> — run now</span>
                        <span>your first edit boots the runtime</span>
                    </div>
                </div>

                {/* the files, printed as tabs ON a rule */}
                <div className="extab-bar b" style={{ '--bd': '.42s' }} role="tablist" aria-label="Example files">
                    {EXAMPLES.map((e, idx) => (
                        <button
                            key={e.id}
                            type="button"
                            role="tab"
                            aria-selected={idx === i}
                            className={`extab${idx === i ? ' on' : ''}`}
                            onClick={() => selectExample(idx)}
                        >
                            <span className="xn">{String(idx + 1).padStart(2, '0')} · </span>{e.file}
                        </button>
                    ))}
                    <span className="extab-note">{ex.blurb}</span>
                </div>

                {/* the bench — machinery intact, F skin */}
                <div className="pane pane-bench b b-flat" style={{ '--bd': '.5s' }}>
                    <LivePlayground
                        initialSource={ex.source}
                        fileLabel={ex.file}
                        defaultPreview={ex.preview}
                        paneHeight="h-[440px] sm:h-[500px]"
                        onEvent={onEngineEvent}
                    />
                </div>

                {/* the quoted log — every real engine event, and nothing else */}
                <div className="pane pane-log pg-log b b-flat" style={{ '--bd': '.62s' }}>
                    <div className="log-head">
                        <span>sandbox log · boots, runs, errors</span>
                        <span className="log-up">{engineState}</span>
                    </div>
                    <div className="log-body" role="log" aria-label="Sandbox activity">
                        {rows.length === 0
                            ? <p className="log-idle">— opens on your first edit</p>
                            : rows.map((r) => (
                                <PgRow key={r.key} m={r.m} p={r.p} s={r.s} ms={r.ms} fresh={r.fresh} />
                            ))}
                    </div>
                </div>

                <p className="pg-iso b b-flat" style={{ '--bd': '.7s' }}>
                    sandboxed iframe · opaque origin · no cookies, no page DOM — in a real app the
                    Python half runs server-side on Starlette; here CPython stands in for the server
                </p>
            </div>
        </section>
    );
}

/* ── 02 · SERVER — the board hits this page's real @action ────────── */

/* The reaction glyphs are the DATA this action counts (VALID_EMOJIS,
   in the Python above) — quoted app content inside the board cells,
   never section markers or icon decoration. */
const EMOJI_MAP = {
    heart: { icon: '❤️', label: 'love' },
    fire: { icon: '🔥', label: 'fire' },
    mind_blown: { icon: '🤯', label: 'mind-blown' },
    rocket: { icon: '🚀', label: 'rocket' },
    sparkles: { icon: '✨', label: 'sparkles' },
    clap: { icon: '👏', label: 'clap' },
};

/* The live handler, verbatim from the top of this file — if you edit
   the Python above, update this string in the same change. */
const REACTION_CODE = `@action
async def react_emoji(request):
    from db import check_rate_limit, get_client_ip, increment_reaction

    client_ip = get_client_ip(request)
    # 5 reactions per hour per IP, scoped to the playground reactions board.
    if not await check_rate_limit(client_ip, scope="react_emoji"):
        raise ActionError(
            "Rate limit reached. Please try again after 1 hour.",
            status_code=429,
        )

    body = await request.json()
    emoji = body.get("emoji", "")
    if emoji not in VALID_EMOJIS:
        raise ActionError("Invalid reaction", status_code=400)

    new_count = await increment_reaction(emoji)
    return {"ok": True, "emoji": emoji, "count": new_count}`;

function CodePlate({ code }) {
    return (
        <pre className="code"><code>
            {tokenizeBlock(code, 'python').map((toks, i) => (
                <React.Fragment key={i}>
                    {toks.length === 0 ? ' ' : toks.map((t, j) => <span key={j} className={t.cls}>{t.text}</span>)}
                    {'\n'}
                </React.Fragment>
            ))}
        </code></pre>
    );
}

function ServerSection({ data }) {
    const [ref, seen] = useSeen();
    const react = useAction('react_emoji');
    const [counts, setCounts] = useState((data && data.reactions) || {});
    const [latency, setLatency] = useState({});
    const [rows, setRows] = useState([]);
    const keyRef = useRef(0);
    const cellEls = useRef({});

    const pushRow = useCallback((row) => {
        keyRef.current += 1;
        const key = keyRef.current;
        setRows((rs) => [
            ...rs.map((r) => (r.fresh ? { ...r, fresh: false } : r)).slice(-4),
            { ...row, key, fresh: true },
        ]);
    }, []);

    const handleClick = async (emoji) => {
        setCounts((p) => ({ ...p, [emoji]: (p[emoji] || 0) + 1 })); // optimistic
        const t0 = performance.now();
        const r = await react({ emoji });
        const ms = Math.round(performance.now() - t0);
        if (r.ok) {
            setCounts((p) => ({ ...p, [r.emoji]: r.count }));
            setLatency((p) => ({ ...p, [emoji]: ms }));
            setTimeout(() => setLatency((p) => { const n = { ...p }; delete n[emoji]; return n; }), 2000);
            // a real 200 landed — flash the cell once (green job 6)
            const el = cellEls.current[emoji];
            if (el) {
                el.classList.remove('hit');
                void el.offsetWidth;
                el.classList.add('hit');
            }
            pushRow({ m: 'POST', p: `react_emoji · ${emoji}`, s: '200', ms: `${ms} ms`, tail: `← {"count": ${r.count}}` });
        } else {
            setCounts((p) => ({ ...p, [emoji]: Math.max(0, (p[emoji] || 1) - 1) }));
            pushRow({ m: 'POST', p: 'react_emoji', s: 'err', ms: `${ms} ms`, tail: r.error || 'request failed' });
        }
    };

    const total = Object.values(counts).reduce((a, b) => a + b, 0);
    const views = data && typeof data.totalViews === 'number' ? data.totalViews.toLocaleString('en-US') : null;
    const lastErr = rows.length && rows[rows.length - 1].s === 'err' ? rows[rows.length - 1].tail : '';

    return (
        <section ref={ref} className={`sec sec-server${seen ? ' seen' : ''}`} id="server">
            <div className="frame">
                <Rulebar tab="02 · Server" href="#server" folio="02" />
                <div className="sec-head rv">
                    <h2>This board hits this page&rsquo;s real @action.</h2>
                    <Receipt>
                        every tap is an HTTP POST to the handler printed alongside — counts persist
                        in SQLite on this server{views ? <> · {views} page loads so far, same database</> : null}
                    </Receipt>
                </div>

                <div className="srv-grid">
                    {/* the board */}
                    <div className="srv-col rv" style={{ '--rvd': '.06s' }}>
                        <div className="pane pane-board">
                            <div className="pane-head">
                                <span>react to this page</span>
                                <span><b>{total}</b> total</span>
                            </div>
                            <div className="rx-grid">
                                {Object.entries(EMOJI_MAP).map(([key, { icon, label }]) => (
                                    <button
                                        key={key}
                                        type="button"
                                        className="rx"
                                        ref={(el) => { cellEls.current[key] = el; }}
                                        onClick={() => handleClick(key)}
                                    >
                                        <span className="ic" aria-hidden="true">{icon}</span>
                                        <span className="lb">{label}</span>
                                        <span className="ct">{counts[key] || 0}</span>
                                        {latency[key] != null && <span className="lat">{latency[key]} ms</span>}
                                    </button>
                                ))}
                            </div>
                            <div className="pane-log pg-log srv-log">
                                <div className="log-head">
                                    <span>request log</span>
                                    <span className="log-up">real HTTP · this server</span>
                                </div>
                                <div className="log-body" role="log" aria-label="Reaction requests">
                                    {rows.length === 0
                                        ? <p className="log-idle">— opens on your first tap</p>
                                        : rows.map((r) => (
                                            <PgRow key={r.key} m={r.m} p={r.p} s={r.s} ms={r.ms} tail={r.tail} fresh={r.fresh} />
                                        ))}
                                </div>
                            </div>
                        </div>
                        <div role="status" aria-live="polite" className="sr">{lastErr}</div>
                    </div>

                    {/* the handler — printed verbatim */}
                    <div className="srv-col rv" style={{ '--rvd': '.14s' }}>
                        <div className="pane pane-handler">
                            <div className="pane-head">
                                <span>pages/playground.pyxl</span>
                                <span>runs on this server</span>
                            </div>
                            <CodePlate code={REACTION_CODE} />
                        </div>
                    </div>
                </div>
            </div>
        </section>
    );
}

/* ── 03 · START — run it for real ─────────────────────────────────── */

const STEPS = [
    'pip install pyxle-framework',
    'pyxle init app',
    'cd app && pyxle dev',
];

function StartSection({ version }) {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-getreal${seen ? ' seen' : ''}`} id="start">
            <div className="frame">
                <Rulebar tab="03 · Start" href="#start" folio="03" />
                <div className="sec-head rv">
                    <h2>Run it for real.</h2>
                    <Receipt>the same anatomy on your machine — the homepage terminal replays a real session</Receipt>
                </div>

                <div className="start-row">
                    <div className="start-steps rv" style={{ '--rvd': '.06s' }}>
                        {STEPS.map((cmd) => <CopyChip key={cmd} text={cmd} />)}
                    </div>
                    <div className="rv" style={{ '--rvd': '.12s' }}>
                        <p className="start-exits" style={{ margin: 0 }}>
                            <Link className="link" href="/docs">Docs</Link>
                            <Link className="link" href="/#start">the captured session <span className="a">→</span></Link>
                            <a className="link" href={GITHUB} target="_blank" rel="noreferrer">GitHub</a>
                        </p>
                        <p className="start-facts">v{version} on PyPI · MIT</p>
                    </div>
                </div>
            </div>
        </section>
    );
}

/* ── Page ─────────────────────────────────────────────────────────── */

export default function PlaygroundPage({ data }) {
    return (
        <>
            <PageMeta
                title="Playground"
                description="Run Pyxle with zero install: edit a real .pyxl and sandboxed in-browser CPython re-runs it live — the actual parser, @server loaders and @action handlers. In a real app that Python runs server-side."
                path="/playground"
            />
            <main id="main">
                <SandboxSection />
                <ServerSection data={data} />
                <StartSection version={data && data.version} />
            </main>
        </>
    );
}
