from pyxle import __version__
from pyxle.runtime import server


@server
async def load(request):
    """Provide the framework version to the shared chrome (layout loader).

    The footer's fact row reads this — the version is pulled live from
    ``pyxle.__version__``, never hardcoded.
    """
    return {"version": __version__}


import './styles/tailwind.css';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/400-italic.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import React from 'react';
import { Head } from 'pyxle/client';
import Analytics from './components/analytics.jsx';
import { MotionRoot } from './components/motion.jsx';
import { ThemeProvider } from './components/theme.jsx';
import { SiteHeader, SiteFooter, MobileBar } from './components/chrome.jsx';
import {
    DEFAULT_TITLE, DEFAULT_DESCRIPTION, DEFAULT_OG_IMAGE, SITE_URL,
} from './components/page-meta.jsx';

/* ════════════════════════════════════════════════════════════════
   THE WORKING COPY · the site chrome.

   One 64px running head on a rule2 hairline (it does not hide on
   scroll — running heads don't dodge), the page, then the EOF
   footer: one newsletter line wired to the REAL subscribe action,
   justified fact/link rows, and "⟨/⟩ view source" pointing at this
   page's actual file on GitHub.

   Fonts self-hosted via @fontsource (IBM Plex Sans variable wght +
   IBM Plex Mono 400/400i/500/600 — the 600 pending a docs bold-in-
   code audit at cleanup), font-display: swap with metric fallbacks —
   the loading strategy that holds the Lighthouse 100. No CDN fonts.

   The design is LIGHT-first: the printed copy is the identity (localStorage
   `pyxle-theme`, default light — system preference deliberately never
   consulted, so the print holds under OS dark mode too). Dark is "the
   lamp copy", an explicit reader's control — components/theme.jsx
   owns the context, the toggle renders in chrome.jsx.

   Colour carries ONE meaning in both themes: Run Green = code that
   runs (seam · prompts/copied · LIVE/200s · Install · decorator
   tokens · execution). Links are never green.

   NAVIGATION DECISIONS (carried over from the previous design): no cross-document
   View Transitions and no hover-prefetch shim — Pyxle's <Link>
   already navigates in-document and prefetches loader data + module
   on hover/viewport-entry.
   ════════════════════════════════════════════════════════════════ */

/* Boot: mark JS availability + stamp the stored theme class before
   first paint (no-FOUC — the original app's exact recipe). Rendered as
   the first child inside #root, so the parser executes it ahead of any
   painted markup. Default is LIGHT, never system-pref: anything other
   than a stored 'light'/'dark' falls through to light (a stored 'dark'
   from the previous design is respected — the visitor chose the lamp). A stored
   dark theme retints <meta name="theme-color"> pre-paint (the React
   effect in theme.jsx keeps it in sync after). Try/caught: storage
   denial still paints a coherent light page. */
const BOOT = `(function(){try{`
    + `var c=document.documentElement.classList;c.add('js');`
    + `var t=localStorage.getItem('pyxle-theme');`
    + `if(t!=='light'&&t!=='dark')t='light';`
    + `c.remove('light','dark');c.add(t);`
    + `if(t==='dark'){var m=document.querySelector('meta[name="theme-color"]');`
    + `if(m)m.setAttribute('content','#20231D');}`
    + `}catch(e){document.documentElement.classList.add('light');`
    + `document.documentElement.classList.add('js');}})();`;

/** The theme hook — state + toggle + persistence live in
 *  components/theme.jsx; this re-export keeps the original app's
 *  import path working: `import { useTheme } from '../layout.jsx'`. */
export { useTheme } from './components/theme.jsx';

export default function RootLayout({ children, data }) {
    const version = data && data.version;
    return (
        <MotionRoot>
            <ThemeProvider>
                {/* The theme boot MUST stay the first painted-order child:
                   it stamps html.light/html.dark (and `js`) before any
                   following markup paints — the no-FOUC contract. */}
                <script dangerouslySetInnerHTML={{ __html: BOOT }} />
                <Analytics />
                {/* Site-wide head defaults. Pages override these through
                   <PageMeta> (components/page-meta.jsx) — Pyxle's head dedup
                   gives the page's tags precedence — so any page that
                   forgets still ships a complete, truthful head. The
                   theme-color content is the LIGHT bond: SSR is
                   theme-blind, so the boot script + theme effect retint
                   it for a stored dark theme. */}
                <Head>
                    <title>{DEFAULT_TITLE}</title>
                    <meta name="description" content={DEFAULT_DESCRIPTION} />
                    <meta name="theme-color" content="#FBFBF9" />
                    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
                    <link rel="alternate icon" href="/favicon.ico" />
                    <meta property="og:title" content={DEFAULT_TITLE} />
                    <meta property="og:description" content={DEFAULT_DESCRIPTION} />
                    <meta property="og:type" content="website" />
                    <meta property="og:url" content={SITE_URL} />
                    <meta property="og:image" content={DEFAULT_OG_IMAGE} />
                    <meta property="og:site_name" content="Pyxle" />
                    <meta name="twitter:card" content="summary_large_image" />
                    <meta name="twitter:image" content={DEFAULT_OG_IMAGE} />
                </Head>
                <div className="min-h-screen">
                    <SiteHeader />
                    {children}
                    <SiteFooter version={version} />
                    <MobileBar />
                </div>
            </ThemeProvider>
        </MotionRoot>
    );
}
