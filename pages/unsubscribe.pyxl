from pyxle.runtime import ActionError

@server
async def load_unsubscribe(request):
    from pyxle import __version__
    from db import UNSUBSCRIBE_REASONS, get_subscriber, verify_unsubscribe_token

    raw_id = request.query_params.get("id", "")
    token = request.query_params.get("token", "")
    try:
        subscriber_id = int(raw_id)
    except (TypeError, ValueError):
        return {"version": __version__, "valid": False}

    if not verify_unsubscribe_token(subscriber_id, token):
        return {"version": __version__, "valid": False}

    row = await get_subscriber(subscriber_id)
    if row is None:
        return {"version": __version__, "valid": False}

    email = row["email"]
    local, _, domain = email.partition("@")
    masked = (local[0] + "•••@" + domain) if local and domain else "your address"

    labels = {
        "too_many_emails": "Too many emails",
        "not_relevant": "Not relevant to me",
        "didnt_signup": "I don't remember signing up",
        "inbox_cleanup": "Just cleaning my inbox",
        "other": "Other",
    }
    return {
        "version": __version__,
        "valid": True,
        "status": "unsubscribed" if row["unsubscribed_at"] else "subscribed",
        "maskedEmail": masked,
        "id": subscriber_id,
        "token": token,
        "reasons": [{"value": r, "label": labels[r]} for r in UNSUBSCRIBE_REASONS],
    }


def _verify(body):
    """Shared guard for the actions — re-verify the signed link server-side;
    never trust the client. Returns the subscriber id or raises 400."""
    from db import verify_unsubscribe_token

    try:
        subscriber_id = int(body.get("id"))
    except (TypeError, ValueError):
        raise ActionError("Invalid unsubscribe link.", status_code=400)
    if not verify_unsubscribe_token(subscriber_id, body.get("token", "")):
        raise ActionError("Invalid unsubscribe link.", status_code=400)
    return subscriber_id


@action
async def do_unsubscribe(request):
    from db import unsubscribe

    body = await request.json()
    subscriber_id = _verify(body)
    if not await unsubscribe(subscriber_id):
        raise ActionError("We couldn't find that subscription.", status_code=404)
    return {"status": "unsubscribed"}


@action
async def do_resubscribe(request):
    from db import resubscribe

    body = await request.json()
    subscriber_id = _verify(body)
    if not await resubscribe(subscriber_id):
        raise ActionError("We couldn't find that subscription.", status_code=404)
    return {"status": "subscribed"}


@action
async def submit_feedback(request):
    from db import record_unsubscribe_feedback

    body = await request.json()
    subscriber_id = _verify(body)
    await record_unsubscribe_feedback(
        subscriber_id,
        reason=(body.get("reason") or "").strip(),
        feedback=(body.get("feedback") or ""),
    )
    return {"ok": True}


import './styles/f-unsubscribe.css';
import React, { useState } from 'react';
import { useAction, Head, Link } from 'pyxle/client';

/* ════════════════════════════════════════════════════════════════
   F — THE WORKING COPY · /unsubscribe — the receipt.
   One ruled block. Unsubscribe is one click; once the action has
   really run, its mono log line prints the genuine 200 (green
   job 3 — the only green on this page). The feedback that follows
   is optional and never blocks leaving; resubscribe stays one
   click away. The three @actions and the HMAC-signed link flow
   above are untouched — this file only rewrites the print.
   ════════════════════════════════════════════════════════════════ */

function FeedbackForm({ reasons, onSubmit, pending }) {
    const [reason, setReason] = useState(null);
    const [text, setText] = useState('');
    return (
        <form
            className="un-fb"
            onSubmit={(e) => { e.preventDefault(); onSubmit(reason, text); }}
        >
            <p className="un-fb-label">Mind telling us why? — optional</p>
            <div className="un-reasons">
                {reasons.map((r) => (
                    <button
                        key={r.value}
                        type="button"
                        aria-pressed={reason === r.value}
                        onClick={() => setReason(reason === r.value ? null : r.value)}
                        className={`un-reason${reason === r.value ? ' on' : ''}`}
                    >
                        {r.label}
                    </button>
                ))}
            </div>
            <textarea
                value={text}
                onChange={(e) => setText(e.target.value)}
                rows={3}
                maxLength={1000}
                placeholder="Anything else? (optional)"
            />
            <button type="submit" className="un-btn" disabled={pending || (!reason && !text.trim())}>
                {pending ? 'Sending…' : 'Send feedback'}
            </button>
        </form>
    );
}

export default function UnsubscribePage({ data }) {
    const { valid, status: initialStatus, maskedEmail, id, token, reasons } = data;

    const unsub = useAction('do_unsubscribe');
    const resub = useAction('do_resubscribe');
    const feedback = useAction('submit_feedback');

    // view: 'subscribed' | 'unsubscribed' | 'feedback_sent' | 'resubscribed'
    const [view, setView] = useState(initialStatus);
    const [justUnsubscribed, setJustUnsubscribed] = useState(false);
    const [receipt, setReceipt] = useState(null);   // { line, note } — printed only for an action that RAN
    const [error, setError] = useState('');

    const onUnsubscribe = async () => {
        setError('');
        const r = await unsub({ id, token });
        if (r.ok) {
            setView('unsubscribed');
            setJustUnsubscribed(true);
            setReceipt({ line: 'POST do_unsubscribe → 200', note: 'you’re off the list' });
        } else setError(r.error || 'Something went wrong.');
    };
    const onResubscribe = async () => {
        setError('');
        const r = await resub({ id, token });
        if (r.ok) {
            setView('resubscribed');
            setJustUnsubscribed(false);
            setReceipt({ line: 'POST do_resubscribe → 200', note: 'welcome back' });
        } else setError(r.error || 'Something went wrong.');
    };
    const onFeedback = async (reason, text) => {
        const r = await feedback({ id, token, reason: reason || '', feedback: text });
        if (r.ok) setView('feedback_sent');
        else setError(r.error || 'Something went wrong.');
    };

    let heading;
    let body;
    if (!valid) {
        heading = 'This link isn’t valid.';
        body = (
            <>
                <p className="un-body">
                    The unsubscribe link is malformed or has expired. If you keep getting
                    emails you didn&rsquo;t ask for, reply to one and we&rsquo;ll sort it out.
                </p>
                <div className="un-row">
                    <Link className="link" href="/">back to pyxle.dev <span className="a">→</span></Link>
                </div>
            </>
        );
    } else if (view === 'subscribed') {
        heading = 'Unsubscribe?';
        body = (
            <>
                <p className="un-body">
                    We&rsquo;ll stop sending Pyxle updates to{' '}
                    <span className="mono-inline">{maskedEmail}</span>. One click, no questions.
                </p>
                <div className="un-row">
                    <button type="button" className="un-btn" onClick={onUnsubscribe} disabled={unsub.pending}>
                        {unsub.pending ? 'Unsubscribing…' : 'Unsubscribe'}
                    </button>
                    <Link className="link" href="/">keep me subscribed</Link>
                </div>
            </>
        );
    } else if (view === 'resubscribed') {
        heading = 'You’re back on the list.';
        body = (
            <>
                <p className="un-body">
                    Welcome back — we&rsquo;ll keep{' '}
                    <span className="mono-inline">{maskedEmail}</span> posted.
                </p>
                <div className="un-row">
                    <Link className="link" href="/">back to pyxle.dev <span className="a">→</span></Link>
                </div>
            </>
        );
    } else {
        // 'unsubscribed' or 'feedback_sent'
        heading = 'You’re unsubscribed.';
        body = (
            <>
                <p className="un-body">
                    <span className="mono-inline">{maskedEmail}</span> won&rsquo;t receive any
                    more Pyxle emails. Changed your mind?{' '}
                    <button type="button" className="link-btn" onClick={onResubscribe} disabled={resub.pending}>
                        resubscribe
                    </button>.
                </p>
                {view === 'feedback_sent' ? (
                    <p className="un-thanks">noted — thank you. it genuinely helps.</p>
                ) : justUnsubscribed ? (
                    <FeedbackForm reasons={reasons} onSubmit={onFeedback} pending={feedback.pending} />
                ) : null}
            </>
        );
    }

    return (
        <>
            <Head>
                <title>Unsubscribe — Pyxle</title>
                <meta name="description" content="Manage your Pyxle email subscription." />
                <meta name="robots" content="noindex" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
            </Head>
            <main id="main" className="un-main">
                <div className="un-wrap">
                    <div className="un-box seen">
                        <div className="rulebar">
                            <span className="tab">@ · Unsubscribe</span>
                        </div>
                        <h1>{heading}</h1>
                        {receipt ? (
                            <p className="un-log"><span className="ok">{receipt.line}</span> · {receipt.note}</p>
                        ) : (
                            <p className="receipt">
                                {valid
                                    ? 'a signed one-click link · verified server-side on every action'
                                    : 'the signed token didn’t verify'}
                            </p>
                        )}
                        {error ? <p className="un-err" role="alert">POST → err · {error}</p> : null}
                        {body}
                    </div>
                </div>
            </main>
        </>
    );
}
