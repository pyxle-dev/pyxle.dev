                    </div>
                ))}
            </div>
        </GpSection>
    );
}


/* ── 04 · Studio & the debugger (the dev surface, shown) ─────────── */

/* The debug specimen: one .pyxl, two breakpoints — one inside the Python
   loader, one inside the React component below it. */
const DEBUG_SPECIMEN = `# post.pyxl

@server
async def load(request):
    pid = request.path_params["id"]
    post = await db.post(pid)
    return {"post": post}


export default function Post({ data }) {
  const words = data.post.body.split(' ').length
  return <h1>{data.post.title} · {words} words</h1>
}`;

/* The two lines that carry a gutter dot — matched on their content, so a
   re-typeset specimen can never strand a mark on the wrong line. */
const BREAKPOINT_LINES = new Set([
    '    post = await db.post(pid)',
    "  const words = data.post.body.split(' ').length",
]);

/* The listing prints its own gutter: a breakpoint dot on those two lines,
   an empty cell on every other, so the marks sit on their lines by
   construction rather than by calibration. */
function DebugListing() {
    const lines = DEBUG_SPECIMEN.split('\n');
    return (
        <pre className="overflow-x-auto p-5 font-mono text-[12.5px] leading-[1.9]">
            <code>
                {tokenizeBlock(DEBUG_SPECIMEN, 'pyxl').map((tokens, i) => (
                    <React.Fragment key={i}>
                        <span
                            aria-hidden="true"
                            className={`mr-3 inline-block h-2 w-2 rounded-full align-middle ${BREAKPOINT_LINES.has(lines[i]) ? 'bg-[#E5534B]' : ''}`}
                        />
                        {tokens.map((t, j) => <span key={j} className={t.cls}>{t.text}</span>)}
                        {'\n'}
                    </React.Fragment>
                ))}
            </code>
        </pre>
    );
}

function StudioAndDebugger() {
    return (
        <GpSection n="04" id="studio-debugger">
            <div className="grid gap-12 lg:grid-cols-12">
                <div className="order-1 min-w-0 lg:col-span-6">
                    <GpHead
                        n="04"
                        eyebrow="Studio & the debugger"
                        title="Two breakpoints, one file."
                        lead="Set one in the @server loader and one in the React component below it — both bind, in the same .pyxl. The VS Code extension contributes each half as its own F5 launch: Backend runs your dev server under the Python debugger, Frontend attaches the browser to it."
                    />
                    <p data-reveal className="mt-8 max-w-[54ch] text-pretty text-base leading-[1.7] text-ink2">
                        The same run serves <span className="text-ink">Studio</span> at{' '}
                        <code className="text-[0.9em] text-acct">/__pyxle/studio</code> — every route with
                        its loaders and actions, a tester that runs them against the live server, and the
                        request feed as it happens. Dev-only by construction: a production{' '}
                        <code className="text-[0.9em] text-acct">pyxle serve</code> doesn't contain it.
                    </p>
                    <div data-reveal className="mt-8 border-t border-rule pt-5">
                        <div className="flex items-center gap-3 font-mono text-[13px] text-ink">
                            <span className="select-none text-acct">$</span>
                            <span className="truncate">pyxle studio</span>
                            <span className="ml-auto"><CopyButton text="pyxle studio" /></span>
                        </div>
                        <p className="mt-3 font-mono text-[11px] leading-relaxed text-ink2">
                            routes · tester · request feed · latency · resolved config · pyxle check
                        </p>
                    </div>
                    <div data-reveal className="mt-5 border-t border-rule pt-5">
                        <div className="flex items-center gap-3 font-mono text-[13px] text-ink">
                            <span className="select-none text-acct">$</span>
                            <span className="truncate">code --install-extension pyxle.pyxle-language-tools</span>
                            <span className="ml-auto"><CopyButton text="code --install-extension pyxle.pyxle-language-tools" /></span>
                        </div>
                        <p className="mt-3 font-mono text-[11px] leading-relaxed text-ink2">
                            F5 needs the extension · already on Pyxle?{' '}
                            <span className="text-ink">pip install --upgrade pyxle-framework</span>
                        </p>
                    </div>
                    <p data-reveal className="mt-7 flex flex-wrap items-center gap-x-7 gap-y-3">
                        <EditorialLink href="/docs/guides/debugging">Debug a .pyxl file →</EditorialLink>
                        <EditorialLink href="/docs/guides/studio">Studio, panel by panel →</EditorialLink>
                        <EditorialLink href="https://marketplace.visualstudio.com/items?itemName=pyxle.pyxle-language-tools" external>
                            Get the VS Code extension ↗
                        </EditorialLink>
                    </p>
                </div>

                <div className="order-2 min-w-0 lg:col-span-6">
                    <div data-reveal style={{ ['--reveal-delay']: '100ms' }}>
                        <Plate
                            label="post.pyxl"
                            meta="two breakpoints"
                            caption={<>Fig. 3 — the <span className="text-ink">loader</span> breakpoint pauses the request in Python; the <span className="text-ink">component</span> breakpoint pauses the render in the browser. Same file, no compiled output to chase.</>}
                        >
                            <div className="duotone">
                                <DebugListing />
                            </div>
                        </Plate>
                    </div>
                </div>
            </div>
        </GpSection>
    );
}


/* ── 05 · The numbers (a typeset ledger) ─────────────────────────── */

// From the July 2026 off-box EC2 run on Pyxle 0.7.1 (2× c7i.2xlarge,
// oha on its own box; SSR measured per core, API at 8 workers) — see /benchmarks.
const LEDGER = [
    ['~2.2×', 'faster server-side rendering than Next.js, per core'],
    ['2–3×', 'smaller HTML than Next.js for the same page'],
    ['1.3×', "FastAPI's throughput on database-heavy pages, at 8 workers"],
];

function CircledZero() {
    return (
        <svg className="h-[0.78em] w-[0.78em]" viewBox="0 0 48 48" fill="none" role="img" aria-label="0">
            <circle cx="24" cy="24" r="20" pathLength="1" className="gp-draw" style={{ ['--draw-dur']: '400ms' }} stroke="var(--c-accent)" strokeWidth="3.5" strokeLinecap="round" transform="rotate(-90 24 24)" />
            <circle cx="24" cy="24" r="4.5" className="gp-dot" style={{ ['--dot-delay']: '420ms' }} fill="var(--c-accent)" />
        </svg>
    );
}

function TheNumbers() {
    return (
        <GpSection n="05" id="numbers">
            <GpHead
                n="05"
                eyebrow="The numbers"
                title="Measured, not marketed."
                lead="Same hardware, same load generator, both frameworks tuned in good faith. When a setup is unfair to a competitor, we fix the setup — not the chart."
            />

            <div className="mt-12 max-w-3xl">
                {/* dt (the label) precedes dd (the value) per the dl content
                   model; flex-row-reverse keeps the numeral typeset left. */}
                <dl>
                    {LEDGER.map(([num, desc], i) => (
                        <div key={num} data-reveal className="flex flex-row-reverse items-baseline justify-between gap-6 border-t border-rule py-5" style={{ ['--reveal-delay']: `${i * 80}ms` }}>
                            <dt className="text-right text-sm text-ink2 sm:text-base">{desc}</dt>
                            <dd className="font-mono text-[2.4rem] font-medium leading-none tracking-tight text-ink sm:text-[3.4rem]">{num}</dd>
                        </div>
                    ))}
                    <div data-reveal className="flex flex-row-reverse items-baseline justify-between gap-6 border-y border-rule py-6" style={{ ['--reveal-delay']: '240ms' }}>
                        <dt className="text-right text-sm text-ink2 sm:text-base">errors under sustained load</dt>
                        <dd className="font-mono text-[2.4rem] font-medium leading-none tracking-tight text-ink sm:text-[3.4rem]"><CircledZero /></dd>
                    </div>
                </dl>
                <p data-reveal className="mt-6 font-mono text-xs leading-relaxed text-ink2">
                    Measured July 2026 on Pyxle 0.7.1, and not re-measured for the 0.9 line.{' '}
                    Reproduce them yourself — full methodology, hardware, and harness at{' '}
                    <Link href="/benchmarks" className="focus-ring rounded text-acct underline decoration-1 underline-offset-4 hover:decoration-2">/benchmarks →</Link>
                </p>
                <p data-reveal className="mt-3 font-mono text-xs leading-relaxed text-ink2" style={{ ['--reveal-delay']: '80ms' }}>
                    Beyond raw speed — the full picture against Django, FastAPI, and Next.js is in{' '}
                    <Link href="/compare" className="focus-ring rounded text-acct underline decoration-1 underline-offset-4 hover:decoration-2">the comparison →</Link>
                </p>
            </div>
        </GpSection>
    );
}


/* ── 06 · For the agents ─────────────────────────────────────────── */

function ContextStrip() {
