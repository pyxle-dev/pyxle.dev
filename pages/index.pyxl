/* ── small shared bits ─────────────────────────────────────────────── */

function Segs({ segs }) {
    return segs.map((seg, i) => (seg.k
        ? <span key={i} className={seg.k}>{seg.s}</span>
        : <React.Fragment key={i}>{seg.s}</React.Fragment>));
}

const fmtUp = (total) => {
    const pad = (n) => (n < 10 ? '0' : '') + n;
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    return 'up ' + (h ? h + ':' + pad(m) : pad(m)) + ':' + pad(s);
};

function ensureVisitorId() {
    try {
        const m = document.cookie.match(/(?:^|;\s*)pyxle_gb=([A-Za-z0-9-]{8,64})(?:;|$)/);
        if (m) {
            localStorage.setItem('pyxle-gb-id', m[1]);
            return m[1];
        }
        const vid = (window.crypto && window.crypto.randomUUID)
            ? window.crypto.randomUUID()
            : Math.random().toString(36).slice(2) + Date.now().toString(36);
        document.cookie = 'pyxle_gb=' + vid + '; path=/; max-age=31536000; SameSite=Lax';
        localStorage.setItem('pyxle-gb-id', vid);
        return vid;
    } catch (e) {
        return null;
    }
}

const reducedNow = () => typeof window !== 'undefined'
    && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ═══ F1 · 01 FILE — the hero: specimen + the file, running ═════════ */

function HeroSection({ data }) {
    const version = data && data.version;
    const seeds = (data && data.entries) || [];
    const uptimeBase = (data && data.uptimeS) || 0;
    const loadMs = data && data.loadMs != null ? data.loadMs : null;

    /* the hero's running head is visible from the start (f.js law) */
    const [seen, setSeen] = useState(false);
    useEffect(() => { setSeen(true); }, []);

    /* ── guestbook state — the one interaction ── */
    const signAction = useAction('sign');
    const myEntries = useAction('my_entries');
    const clearAction = useAction('clear_mine');
    const [entries, setEntries] = useState(seeds);
    const [freshId, setFreshId] = useState(null);
    const [hint, setHint] = useState({ text: 'sign it — watch the file run', told: false });
    const [errField, setErrField] = useState(null);
    const [signCount, setSignCount] = useState(0);

    /* the request log — GET/LOAD SSR with measured values; POST rows land live */
    const [getMs, setGetMs] = useState(null);          // '—' until Navigation Timing (post-mount)
    const [postLines, setPostLines] = useState([]);    // rotating live rows
    const [tick, setTick] = useState(0);               // uptime seconds since mount

    const rowEls = useRef({});
    const busyRef = useRef(false);
    const timersRef = useRef([]);
    const nameRef = useRef(null);
    const noteRef = useRef(null);

    const later = useCallback((fn, ms) => { timersRef.current.push(setTimeout(fn, ms)); }, []);
    useEffect(() => () => { timersRef.current.forEach(clearTimeout); }, []);

    /* mount: visitor cookie; a returning signer's rows come back (the
       persistence IS the proof it's real); real Navigation Timing for
       the GET line; the uptime starts ticking. All measure-after-mount. */
    useEffect(() => {
        ensureVisitorId();
        let alive = true;
        try {
            if (localStorage.getItem('pyxle-gb-signed') === '1') {
                myEntries({}).then((r) => {
                    if (alive && r.ok && Array.isArray(r.entries)) setEntries(r.entries);
                });
            }
        } catch (e) { /* storage denied — seeds stay */ }
        try {
            const nav = performance.getEntriesByType('navigation')[0];
            if (nav && nav.responseEnd > 0) {
                setGetMs(Math.max(0.1, Math.round((nav.responseEnd - nav.requestStart) * 10) / 10));
            }
        } catch (e) { /* timing unavailable — the cell keeps its — */ }
        const iv = setInterval(() => setTick((t) => t + 1), 1000);
        return () => { alive = false; clearInterval(iv); };
        // eslint-disable-next-line react-hooks/exhaustive-deps
    }, []);

    const flash = useCallback((ids, cls, ms) => {
        const els = ids.map((id) => rowEls.current[id]).filter(Boolean);
        els.forEach((el) => el.classList.add(cls));
        later(() => els.forEach((el) => el.classList.remove(cls)), ms);
    }, [later]);

    const addLog = useCallback((status, ms, tail, path) => {
        setPostLines((lines) => {
            const next = lines.concat({
                key: Date.now() + Math.random(),
                s: status,
                ms,
                tail,
                p: path || '/action/sign',
            });
            return next.slice(-1);   /* one live row + GET + LOAD = the pane's three */
        });
    }, []);

    const say = useCallback((text) => setHint({ text, told: true }), []);

    const onSubmit = useCallback(async (e) => {
        e.preventDefault();
        if (busyRef.current) return;
        busyRef.current = true;
        const payload = Object.fromEntries(new FormData(e.target));
        const t0 = performance.now();
        const r = await signAction(payload);          /* the REAL POST */
        const ms = Math.max(0.1, Math.round((performance.now() - t0) * 10) / 10);
        const reduced = reducedNow();

        if (!r.ok && r.fields) {
            /* the framework's real 422 — Pydantic rejected it, sign never ran */
            const missing = Object.keys(r.fields)[0] || 'note';
            setErrField(missing === 'name' ? 'name' : 'note');
            flash(['L4', 'L5', 'L6'], 'locate', 900);
            addLog(422, ms, `{"fields": {"${missing}": […]}}`);
            say(`422 — Entry wants a ${missing} · the action never ran`);
            const el = missing === 'name' ? nameRef.current : noteRef.current;
            if (el) el.focus();
            busyRef.current = false;
            return;
        }
        if (!r.ok) {
            /* rate-limited (429) or down — the server's own words */
            const resting = (r.error || '').indexOf('resting') !== -1;
            addLog(resting ? 429 : 'ERR', ms, r.error || 'request failed');
            say(r.error || 'request failed');
            busyRef.current = false;
            return;
        }

        try { localStorage.setItem('pyxle-gb-signed', '1'); } catch (err) { /* fine */ }
        const nextCount = signCount + 1;
        setSignCount(nextCount);
        track('guestbook_signed', { nth: nextCount });
        const newest = r.entries && r.entries[0];

        const finish = () => {
            setEntries(r.entries || []);
            setFreshId(newest ? newest.id : null);
            setErrField(null);
            if (nameRef.current) nameRef.current.value = '';
            if (noteRef.current) noteRef.current.value = '';
            say(nextCount === 1
                ? 'that ran @action sign · lines 12–15'
                : `@action ran again · ${nextCount} requests, no API layer`);
            busyRef.current = false;
        };

        if (reduced) {
            addLog(200, ms, '{"entries": […]}');
            finish();
            return;
        }
        /* the request, staged: wire → seam → server → log → state */
        flash(['L19', 'L23'], 'flash', 460);
        later(() => {
            const seam = rowEls.current.L16;
            if (seam) {
                seam.classList.add('seam-pulse');
                later(() => seam.classList.remove('seam-pulse'), 600);
            }
        }, 170);
        ['L12', 'L13', 'L14', 'L15'].forEach((id, i) => {
            later(() => flash([id], 'flash', 340), 270 + i * 75);
        });
        later(() => addLog(200, ms, '{"entries": […]}'), 600);
        later(finish, 760);
    }, [signAction, signCount, flash, addLog, say, later]);

    /* clearing is its own real request — the eraser is part of the demo */
    const onClear = useCallback(async () => {
        if (busyRef.current) return;
        busyRef.current = true;
        const t0 = performance.now();
        const r = await clearAction({});
        const ms = Math.max(0.1, Math.round((performance.now() - t0) * 10) / 10);
        if (r.ok) {
            setEntries(r.entries || []);
            setFreshId(null);
            try { localStorage.removeItem('pyxle-gb-signed'); } catch (err) { /* fine */ }
            addLog(200, ms, `{"cleared": ${r.cleared != null ? r.cleared : 0}}`, '/action/clear_mine');
            say(r.cleared ? `cleared — ${r.cleared} of your ${r.cleared === 1 ? 'row' : 'rows'} deleted, seeds remain` : 'nothing of yours to clear');
            track('guestbook_cleared', { rows: r.cleared || 0 });
        } else {
            addLog('ERR', ms, r.error || 'request failed', '/action/clear_mine');
            say(r.error || 'request failed');
        }
        busyRef.current = false;
    }, [clearAction, addLog, say]);

    /* marginalia ↔ listing: notes and lines locate each other */
    const annEls = useRef({});
    const locate = useCallback((target, on2) => {
        const row = rowEls.current[target];
        if (row) row.classList[on2 ? 'add' : 'remove']('locate');
    }, []);
    const light = useCallback((target, on2) => {
        const ann = annEls.current[target];
        if (ann) ann.classList[on2 ? 'add' : 'remove']('lit');
    }, []);

    let printIdx = 0;

    return (
        <section className={`sec sec-hero${seen ? ' seen' : ''}`} id="file">
            <div className="frame">
                <Rulebar hero tab="01 · File" href="#file" />
                <div className="hero-head">
                    <h1 className="b" style={{ '--bd': '.05s' }}>
                        The backend and&nbsp;the&nbsp;page.<br />
                        <span className="emph">One&nbsp;file.<span className="emph-rule" aria-hidden="true" /></span>
                    </h1>
                    <Receipt className="b" style={{ '--bd': '.22s' }}>
                        guestbook.pyxl · 33 lines · Python 3.10+ · React 18/19
                    </Receipt>
                    <div
                        className="stamp b b-stamp" style={{ '--bd': '.5s' }} role="note"
                        aria-label={`Working copy — v${version}, PyPI, MIT — runs as printed`}
                    >
                        <span className="stamp-top">Working copy</span>
                        <span className="stamp-mid">v{version} · PyPI · MIT</span>
                        <span className="stamp-low">runs as printed</span>
                    </div>
                </div>

                <div className="hero-grid">
                    {/* left: the specimen */}
                    <div className="specimen-wrap">
                        <svg className="leaders b b-flat" style={{ '--bd': '1.15s' }} aria-hidden="true" viewBox="0 0 32 780" preserveAspectRatio="none">
                            <polyline points="0,211 10,211 26,238" /><circle cx="28" cy="238" r="2" />
                            <polyline points="0,289 10,289 26,260" /><circle cx="28" cy="260" r="2" />
                            <polyline points="0,413 10,413 26,414" /><circle cx="28" cy="414" r="2" />
                            <polyline points="0,487 10,487 26,458" /><circle cx="28" cy="458" r="2" />
                        </svg>
                        <div className="marginalia b b-flat" style={{ '--bd': '1.15s' }}>
                            {ANNS.map((ann) => (
                                <p
                                    key={ann.target}
                                    ref={(el) => { annEls.current[ann.target] = el; }}
                                    className="ann"
                                    style={{ '--y': `${ann.y}px` }}
                                    onMouseEnter={() => locate(ann.target, true)}
                                    onMouseLeave={() => locate(ann.target, false)}
                                >
                                    <span className="ann-n">{ann.n}</span> {ann.text}
                                </p>
                            ))}
                        </div>

                        <figure className="pane pane-specimen b b-flat" style={{ '--bd': '.14s', margin: 0 }}>
                            <figcaption className="pane-head">
                                <span className="ph-path">pages/guestbook.pyxl</span>
                                <span className="ph-meta">33 lines</span>
                            </figcaption>
                            <pre className="code" id="specimen"><code>
                                {SPEC_ROWS.map((row) => {
                                    const rd = `${(0.4 + printIdx * 0.021).toFixed(3)}s`;
                                    printIdx += 1;
                                    if (row.seam) {
                                        return (
                                            <span
                                                key="L16" id="L16"
                                                ref={(el) => { rowEls.current.L16 = el; }}
                                                className="row seam-row" style={{ '--rd': rd }}
                                                aria-label="line 16, blank — the seam"
                                            >
                                                <span className="n">16</span>
                                                <span className="t" />
                                                <span className="seam-halo" />
                                                <span className="seam-line" />
                                                <span className="seam-tag"># ← the API layer (one blank line)</span>
                                            </span>
                                        );
                                    }
                                    if (row.cont) {
                                        return (
                                            <span key={`cont-${printIdx}`} className="row mob-only" style={{ '--rd': rd }}>
                                                <span className="n" />
                                                <span className="t"><Segs segs={row.segs} /></span>
                                            </span>
                                        );
                                    }
                                    const id = `L${row.n}`;
                                    const cls = `row${row.act ? ' act' : ''}${row.wire ? ' wire' : ''}`;
                                    return (
                                        <span
                                            key={id} id={id} className={cls} style={{ '--rd': rd }}
                                            ref={(el) => { rowEls.current[id] = el; }}
                                            onMouseEnter={ANNS.some((a) => a.target === id) ? () => light(id, true) : undefined}
                                            onMouseLeave={ANNS.some((a) => a.target === id) ? () => light(id, false) : undefined}
                                        >
                                            <span className="n">{row.n}</span>
                                            <span className="t">
                                                {row.mob ? (
                                                    <>
                                                        <span className="dsk"><Segs segs={row.segs} /></span>
                                                        <span className="mob"><Segs segs={row.mob} /></span>
                                                    </>
                                                ) : <Segs segs={row.segs} />}
                                            </span>
                                        </span>
                                    );
                                })}
                            </code></pre>
                        </figure>

                        <ol className="ann-strip b" style={{ '--bd': '.9s' }} aria-label="How to read the file">
                            <li><span className="ann-n">1·</span> loader runs on the server <span className="ann-at">— line 9</span></li>
                            <li><span className="ann-n">2·</span> its return value is the page&rsquo;s props <span className="ann-at">— line 10</span></li>
                            <li><span className="ann-n">3·</span> HTML arrives finished, then hydrates <span className="ann-at">— line 17</span></li>
                            <li><span className="ann-n">4·</span> the button calls Python in the same file <span className="ann-at">— line 19</span></li>
                        </ol>
                    </div>

                    {/* right: the result — the file, running on this server */}
                    <div className="result-col">
                        <figure className="pane pane-result b" style={{ '--bd': '1s', margin: 0 }}>
                            <figcaption className="pane-head pane-head-url">
                                <span className="urlbar">localhost:8000</span>
                                <span className="devchip">dev</span>
                            </figcaption>
                            <div className="app">
                                <h2 className="app-h">Guestbook</h2>
                                <ul className="app-list">
                                    {entries.slice(0, 3).map((entry) => (
                                        <li key={entry.id} className={entry.id === freshId ? 'fresh' : undefined}>
                                            <b>{entry.name}</b> {entry.note}
                                            {entry.you ? <span className="you-tag">you</span> : null}
                                        </li>
                                    ))}
                                </ul>
                                <form className="app-form" onSubmit={onSubmit} autoComplete="off">
                                    <input
                                        ref={nameRef} name="name" placeholder="name" aria-label="name"
                                        className={errField === 'name' ? 'err' : undefined}
                                        onInput={() => errField === 'name' && setErrField(null)}
                                    />
                                    <input
                                        ref={noteRef} name="note" placeholder="note" aria-label="note"
                                        className={errField === 'note' ? 'err' : undefined}
                                        onInput={() => errField === 'note' && setErrField(null)}
                                    />
                                    <button type="submit">Sign</button>
                                </form>
                                <p className={`app-hint${hint.told ? ' told' : ''}`} aria-live="polite">{hint.text}</p>
                            </div>
                        </figure>

                        <p className="gb-honesty b" style={{ '--bd': '1.06s' }}>
                            seed entries are authored · yours are real — stored by this
                            server, shown only to your browser
                            {entries.some((entry) => entry.you) ? (
                                <> · <button type="button" className="gb-clear" onClick={onClear}>clear yours</button></>
                            ) : null}
                        </p>

                        <figure className="pane pane-log b" style={{ '--bd': '1.12s', margin: 0 }}>
                            <figcaption className="log-head">
                                <span>request log</span>
                                <span className="log-up" aria-hidden="true">{fmtUp(uptimeBase + tick)}</span>
                            </figcaption>
                            <div className="log-body">
                                <p className="log-line">
                                    <span className="lg-m">GET</span><span className="lg-p">/</span>
                                    <span className="lg-s">200</span>
                                    <span className="lg-ms">{getMs === null ? '—' : `${getMs} ms`}</span>
                                    <span className="lg-c">← HTML, finished</span>
                                </p>
                                <p className="log-line">
                                    <span className="lg-m">LOAD</span><span className="lg-p">load_home()</span>
                                    <span className="lg-s">200</span>
                                    <span className="lg-ms">{loadMs === null ? '—' : loadMs < 0.1 ? '<0.1 ms' : `${loadMs.toFixed(1)} ms`}</span>
                                    <span className="lg-c">← {'{"entries": […]}'}</span>
                                </p>
                                {postLines.map((line) => (
                                    <p key={line.key} className="log-line fresh-log">
                                        <span className="lg-m">POST</span><span className="lg-p">{line.p}</span>
                                        <span className={`lg-s${String(line.s) === '200' ? '' : ' lg-4xx'}`}>{line.s}</span>
                                        <span className="lg-ms">{line.ms} ms</span>
                                        <span className="lg-c">← {line.tail}</span>
                                    </p>
                                ))}
                            </div>
                        </figure>

                        <div className="hero-ctas b" style={{ '--bd': '1.22s' }}>
                            <CopyChip text={INSTALL} quickstart />
                            <p className="cta-line">
                                <Link className="link" href="/playground">Open the playground <span className="a">→</span></Link>
                            </p>
                            <p className="cta-receipt">
                                <span>runs .pyxl files in your browser</span> <span>· CPython via Pyodide</span> <span>· ~12&nbsp;MB once</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    );
}

/* ═══ F2 · 02 REQUEST — FIG 01 draws itself, then the request runs ══ */

function RequestSection() {
    const [ref, seen] = useSeen();
    const figRef = useRef(null);
    const runRef = useRef(null);
    const [runVisible, setRunVisible] = useState(false);

    useEffect(() => {
        const fig = figRef.current;
        if (!fig || reducedNow() || typeof IntersectionObserver === 'undefined') return undefined;
        fig.classList.add('pre');
        const timers = [];
        const race = () => {
            fig.classList.remove('race');
            void fig.offsetWidth;               /* restart the animation */
            fig.classList.add('race');
        };
        fig._race = race;
        let fired = false;
        const io = new IntersectionObserver((entries) => {
            entries.forEach((en) => {
                if (en.isIntersecting && !fired) {
                    fired = true;
                    requestAnimationFrame(() => fig.classList.add('go'));
                    timers.push(setTimeout(race, 1500));
                    timers.push(setTimeout(() => setRunVisible(true), 4800));
                    io.disconnect();
                }
            });
        }, { threshold: 0.45 });
        io.observe(fig);
        return () => { io.disconnect(); timers.forEach(clearTimeout); };
    }, []);

    const runAgain = useCallback(() => {
        const btn = runRef.current;
        const fig = figRef.current;
        if (btn) {
            btn.classList.remove('spin');
            void btn.offsetWidth;
            btn.classList.add('spin');
        }
        if (fig && fig._race) fig._race();
    }, []);

    return (
        <section ref={ref} className={`sec sec-request${seen ? ' seen' : ''}`} id="request">
            <div className="frame">
                <Rulebar tab="02 · Request" href="#request" folio="02" />
                <div className="sec-head rv">
                    <h2>One request, start to finish.</h2>
                    <Receipt>what the server does, in order — no magic left in the margin</Receipt>
                </div>

                <figure ref={figRef} className="fig plate rv" id="fig01" style={{ '--rvd': '.08s' }}>
                    <div className="plate-head">
                        <span className="plate-tag">FIG 01</span>
                        <button ref={runRef} className="fig-run" type="button" hidden={!runVisible} onClick={runAgain}>
                            <span className="rg">↻</span> run it again
                        </button>
                    </div>
                    <div className="fig-grid">
                        <span className="rail-label">pyxle</span>
                        <div className="rail rail-pyxle">
                            <span className="pip pip-pyxle" aria-hidden="true" />
                            <span className="node nd" style={{ '--i': 0 }}>GET /</span>
                            <span className="conn cn" style={{ '--i': 1 }} />
                            <span className="node nd" style={{ '--i': 2 }}>load(request)</span>
                            <span className="conn cn" style={{ '--i': 3 }} />
                            <span className="node nd" style={{ '--i': 4 }}>props</span>
                            <span className="conn conn-seam cn" style={{ '--i': 5 }}>
                                <span className="cap cap-server">server side</span>
                                <span className="cap cap-browser">browser side</span>
                            </span>
                            <span className="node nd" style={{ '--i': 6 }}>HTML</span>
                            <span className="conn cn" style={{ '--i': 7 }} />
                            <span className="node nd nd-final" style={{ '--i': 8 }}>hydrate()</span>
                        </div>
                        <span className="rail-label rail-label-conv">conventional</span>
                        <div className="rail rail-conv">
                            <span className="pip pip-conv" aria-hidden="true" />
                            <span className="cnode">route</span>
                            <span className="conn conn-tick" />
                            <span className="cnode">serialize</span>
                            <span className="conn conn-tick" />
                            <span className="cnode">fetch</span>
                            <span className="conn conn-tick" />
                            <span className="cnode">parse</span>
                            <span className="conn conn-tick" />
                            <span className="cnode">render</span>
                        </div>
                    </div>
                    <figcaption className="fig-cap">the same request, with and without an API layer.</figcaption>
                </figure>
            </div>
        </section>
    );
}

/* ═══ F3 · 03 FRAMEWORK — six ruled cells, every one linked ═════════ */

function Cell({ tab, ver, children, note, href, path, delay }) {
    return (
        <div className="cell rv" style={{ '--rvd': delay }}>
            <h3 className="cell-tab">{tab}{ver ? <span className="chip-ver">{ver}</span> : null}</h3>
            {children}
            <p className="cell-note">{note}</p>
            <p className="cell-link">
                <Link className="link" href={href}>docs <span className="a">→</span></Link>
                <span className="cell-path">{path}</span>
            </p>
        </div>
    );
}

function FrameworkSection({ docsCount }) {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-framework${seen ? ' seen' : ''}`} id="framework">
            <div className="frame">
                <Rulebar tab="03 · Framework" href="#framework" folio="03" />
                <div className="sec-head rv">
                    <h2>A whole framework, not a trick.</h2>
                    <Receipt>
                        {docsCount
                            ? `six of ${docsCount} documented pages — every cell links to its docs`
                            : 'six documented corners — every cell links to its docs'}
                    </Receipt>
                </div>

                <div className="cells">
                    <Cell
                        tab="Routing" delay="0.05s" note="Files are routes. Brackets are params."
                        href="/docs/core-concepts/routing" path="/docs/core-concepts/routing"
                    >
                        <pre className="art"><code>{'pages/\n├── index.pyxl          '}<span className="c">→ /</span>{'\n├── layout.pyxl         '}<span className="c">→ wraps children</span>{'\n└── posts/\n   └── [slug].pyxl      '}<span className="c">→ /posts/:slug</span></code></pre>
                    </Cell>

                    <Cell
                        tab="Streaming SSR" delay="0.12s" note="HTML streams while Python awaits."
                        href="/docs/guides/streaming" path="/docs/guides/streaming"
                    >
                        <pre className="art"><code><span className="c">&lt;</span>h1<span className="c">&gt;{'{'}</span>data.title<span className="c">{'}'}&lt;/</span>h1<span className="c">&gt;</span>  <span className="c">{'{/* shell */}'}</span>{'\n\n'}<span className="c">&lt;</span>Suspense fallback<span className="c">={'{'}&lt;</span>p<span className="c">&gt;</span>Loading…<span className="c">&lt;/</span>p<span className="c">&gt;{'}'}&gt;</span>{'\n  '}<span className="c">&lt;</span>ActivityFeed <span className="c">/&gt;</span>  <span className="c">{'{/* streams in */}'}</span>{'\n'}<span className="c">&lt;/</span>Suspense<span className="c">&gt;</span></code></pre>
                    </Cell>

                    <Cell
                        tab="Validated actions" delay="0.19s"
                        note={<>The hero&rsquo;s <span className="mono-inline">Entry</span> model, failing honestly: per-field errors, typed.</>}
                        href="/docs/core-concepts/server-actions" path="/docs/core-concepts/server-actions"
                    >
                        <pre className="art"><code><span className="g">@action</span>{'\n'}async def sign<span className="c">(</span>request<span className="c">,</span> body<span className="c">:</span> Entry<span className="c">):</span> …</code></pre>
                        <pre className="art art-json"><code><span className="c">{'// bad input — 422, action never ran'}</span>{'\n'}<span className="c">{'{"ok":'}</span> false<span className="c">,</span>{'\n '}<span className="c">{'"error": "Validation failed",'}</span>{'\n '}<span className="c">{'"fields": {"note": ["Field required"]}}'}</span></code></pre>
                    </Cell>

                    <Cell
                        tab="Realtime" delay="0.26s"
                        note={<>The page serves its own WebSocket. Abridged from <span className="mono-inline">examples/chat</span>.</>}
                        href="/docs/guides/websockets" path="/docs/guides/websockets"
                    >
                        <pre className="art"><code>async with channel<span className="c">(</span>{'\n        '}ws<span className="c">,</span> f<span className="c">{'"room:{'}</span>room<span className="c">{'}")'}</span> as live<span className="c">:</span>{'\n    '}async for text in ws.iter_text<span className="c">():</span>{'\n        '}await live.publish<span className="c">(</span>text<span className="c">)</span>{'\n\n'}const <span className="c">{'{'}</span> send <span className="c">{'}'}</span> = useWebSocket<span className="c">(</span>{'\n  '}<span className="c">'/chat/'</span> + room<span className="c">, {'{'}</span> onMessage <span className="c">{'})'}</span></code></pre>
                    </Cell>

                    <Cell
                        tab="Auth plugin" ver="pyxle-auth 0.4" delay="0.33s"
                        note={<>Sliding sessions in HttpOnly cookies; <span className="mono-inline">request.user</span> on every loader.</>}
                        href="/docs/plugins/pyxle-auth" path="/docs/plugins/pyxle-auth"
                    >
                        <pre className="art"><code>const <span className="c">{'{'}</span> user<span className="c">,</span> isAuthenticated<span className="c">,</span>{'\n        '}logout <span className="c">{'}'}</span> = useAuth<span className="c">()</span>{'\n\n'}if <span className="c">(!</span>isAuthenticated<span className="c">)</span>{'\n  '}return <span className="c">&lt;</span>a href<span className="c">="/login"&gt;</span>Sign in<span className="c">&lt;/</span>a<span className="c">&gt;</span></code></pre>
                    </Cell>

                    <Cell
                        tab="Studio &amp; debugger" delay="0.40s"
                        note="Routes, requests, metrics — and breakpoints in .pyxl files."
                        href="/docs/guides/studio" path="/docs/guides/studio"
                    >
                        <img className="cell-shot" src="/shots/studio.png" alt="Pyxle Studio at /__pyxle/studio — route table of a scaffolded app" width="1200" height="520" loading="lazy" />
                    </Cell>
                </div>
            </div>
        </section>
    );
}

/* ═══ F4 · 04 NUMBERS — every figure carries its own conditions ═════ */

function NumbersSection({ docsCount }) {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-numbers${seen ? ' seen' : ''}`} id="numbers">
            <div className="frame">
                <Rulebar tab="04 · Numbers" href="#numbers" folio="04" />
                <div className="sec-head rv">
                    <h2>Numbers we can defend.</h2>
                    <Receipt>every figure carries its own test conditions</Receipt>
                </div>

                <div className="tiles">
                    <div className="tile tile-wide rv" style={{ '--rvd': '.06s' }}>
                        <p className="tile-v">~2.2×</p>
                        <div className="bars" aria-hidden="true">
                            <p className="bar-row"><span className="bar-l">pyxle</span><span className="bar-track"><span className="bar bar-g" style={{ '--w': '100%' }} /></span><span className="bar-n">2.2</span></p>
                            <p className="bar-row"><span className="bar-l">next.js</span><span className="bar-track"><span className="bar bar-k" style={{ '--w': '45.5%' }} /></span><span className="bar-n">1.0</span></p>
                        </div>
                        <p className="tile-l">median per-core SSR throughput vs Next.js</p>
                        <p className="tile-c">measured July 2026 on Pyxle 0.7.1 · normalized, Next.js = 1.0 · full harness → <Link className="link" href="/benchmarks">/benchmarks</Link></p>
                    </div>
                    <div className="tile rv" style={{ '--rvd': '.13s' }}>
                        <p className="tile-v tile-v-word">FastAPI<br />parity</p>
                        <p className="tile-l">raw JSON endpoints</p>
                        <p className="tile-c">same harness, July 2026 · Pyxle is Starlette underneath</p>
                    </div>
                    <div className="tile rv" style={{ '--rvd': '.2s' }}>
                        <p className="tile-v">{docsCount != null ? docsCount : '—'}</p>
                        <p className="tile-l">documentation pages, in the repo</p>
                        <p className="tile-c">counted from the docs manifest at load · <Link className="link" href="/docs">/docs</Link></p>
                    </div>
                    <div className="tile tile-last rv" style={{ '--rvd': '.27s' }}>
                        <p className="tile-v">3</p>
                        <p className="tile-l">apps we run in production</p>
                        <p className="tile-c">all three below ↓ · click them</p>
                    </div>
                </div>
            </div>
        </section>
    );
}

