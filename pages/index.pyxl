/* ═══ F6 · 06 START — three commands; the terminal replays a real
       captured session, and the typing lights each step ═════════════ */

function QuickTerminal({ onStep }) {
    const [view, setView] = useState(null);   // null → the full static transcript (SSR truth)
    const playingRef = useRef(false);
    const playedRef = useRef(false);
    const timersRef = useRef([]);
    const bodyRef = useRef(null);
    const replayRef = useRef(null);

    const later = useCallback((fn, ms) => { timersRef.current.push(setTimeout(fn, ms)); }, []);
    useEffect(() => () => timersRef.current.forEach(clearTimeout), []);

    const play = useCallback(() => {
        if (playingRef.current) return;
        playingRef.current = true;
        let li = 0;
        const nextLine = () => {
            if (li >= TERM_LINES.length) {
                playingRef.current = false;
                setView({ upTo: TERM_LINES.length, partial: null, cursor: true });
                onStep(-1);
                return;
            }
            const line = TERM_LINES[li];
            if (line.charAt(0) === '$') {
                onStep(STEPS.findIndex((st) => line.indexOf(st.match) !== -1));
                let ci = 1;
                const tick = () => {
                    setView({ upTo: li, partial: line.slice(0, ci), cursor: true });
                    ci += 1;
                    if (ci <= line.length) {
                        later(tick, 16);
                    } else {
                        li += 1;
                        setView({ upTo: li, partial: null, cursor: true });
                        later(nextLine, 300);
                    }
                };
                tick();
            } else {
                li += 1;
                setView({ upTo: li, partial: null, cursor: true });
                later(nextLine, line === '' ? 40 : 115);
            }
        };
        nextLine();
    }, [later, onStep]);

    useEffect(() => {
        const el = bodyRef.current;
        if (!el || reducedNow() || typeof IntersectionObserver === 'undefined') return undefined;
        const io = new IntersectionObserver((entries) => {
            entries.forEach((en) => {
                if (en.isIntersecting && !playedRef.current) {
                    playedRef.current = true;
                    play();
                    io.disconnect();
                }
            });
        }, { threshold: 0.4 });
        io.observe(el);
        return () => io.disconnect();
    }, [play]);

    const replay = useCallback(() => {
        if (playingRef.current) return;
        const btn = replayRef.current;
        if (btn) {
            btn.classList.remove('spin');
            void btn.offsetWidth;
            btn.classList.add('spin');
        }
        if (reducedNow()) { setView(null); return; }
        play();
    }, [play]);

    const renderLine = (line, key, partial) => {
        const text = partial != null ? partial : line;
        if (text.charAt(0) === '$') {
            return <React.Fragment key={key}><span className="tg2">$</span>{text.slice(1)}{partial == null ? '\n' : ''}</React.Fragment>;
        }
        return <React.Fragment key={key}>{text}{partial == null ? '\n' : ''}</React.Fragment>;
    };

    const shown = view === null
        ? TERM_LINES.map((line, i) => renderLine(line, i))
        : TERM_LINES.slice(0, view.upTo).map((line, i) => renderLine(line, i))
            .concat(view.partial != null ? [renderLine(view.partial, 'partial', view.partial)] : []);

    return (
        <figure className="terminal-wrap rv" style={{ '--rvd': '.12s', margin: 0 }}>
            <div className="terminal">
                <div className="term-head">
                    <span className="term-title">terminal</span>
                    <button ref={replayRef} className="term-replay" type="button" onClick={replay}>
                        <span className="rg">↻</span> replay
                    </button>
                </div>
                <pre ref={bodyRef} className="term-body"><code>
                    {shown}
                    {view && view.cursor ? <span className="term-cursor" aria-hidden="true" /> : null}
                </code></pre>
            </div>
            <figcaption className="term-cap">{TERM_CAPTION}</figcaption>
        </figure>
    );
}

function StartSection() {
    const [ref, seen] = useSeen();
    const [stepOn, setStepOn] = useState(-1);
    return (
        <section ref={ref} className={`sec sec-start${seen ? ' seen' : ''}`} id="start">
            <div className="frame">
                <Rulebar tab="06 · Start" href="#start" folio="06" />
                <div className="sec-head rv">
                    <h2>Three commands to a running app.</h2>
                    <Receipt>the terminal on the right replays a real captured session</Receipt>
                </div>

                <div className="start-grid">
                    <div className="steps rv" style={{ '--rvd': '.06s' }}>
                        {STEPS.map((st, i) => (
                            <div key={st.n} className={`step${stepOn === i ? ' on' : ''}`}>
                                <span className="step-n">{st.n}</span>
                                <CopyChip text={st.cmd} quickstart />
                            </div>
                        ))}
                        <div className="exits">
                            <Link className="link" href="/docs">Docs</Link>
                            <Link className="link" href="/playground">Playground</Link>
                            <a className="link" href={GITHUB} target="_blank" rel="noreferrer">GitHub</a>
                        </div>
                    </div>
                    <QuickTerminal onStep={setStepOn} />
                </div>
            </div>
        </section>
    );
}

/* ═══ the header star count ════════════════════════════════════════
   Page-contributed into the layout header's `nav-extra` slot (the docs
   page's own mechanism) — homepage-only by construction, zero
   layout.pyxl surface. Renders NOTHING while the loader has no number
   yet (first-ever request, GitHub down): the header is then
   byte-identical to every other page's. Locale pinned so server and
   client format the same bytes. */
const fmtStars = (n) => (n < 10000 ? n.toLocaleString('en-US') : (n / 1000).toFixed(1) + 'k');

export const createSlots = (props) => {
    const data = props && props.data;
    const n = data && typeof data.stars === 'number' ? data.stars : null;
    if (n === null) return {};
    return {
        'nav-extra': () => (
            <a
                className="hd-stars starrable" href={GITHUB} target="_blank" rel="noreferrer"
                aria-label={'GitHub — ' + fmtStars(n) + ' stars'}
            ><StarIcon />{fmtStars(n)}</a>
        ),
    };
};

/* ═══ the page ═════════════════════════════════════════════════════
   Header, footer, the real newsletter line and the mobile bar all
   arrive from pages/layout.pyxl — this file prints the document. */
export default function Page({ data }) {
    return (
        <>
            <PageMeta fullTitle={DEFAULT_TITLE} description={DEFAULT_DESCRIPTION} path="/" />
            <main id="main">
                <HeroSection data={data} />
                <RequestSection />
                <FrameworkSection docsCount={data && data.docsCount} />
                <NumbersSection docsCount={data && data.docsCount} />
                <ProductionSection stars={data && data.stars} docsCount={data && data.docsCount} />
                <StartSection />
            </main>
        </>
    );
}
