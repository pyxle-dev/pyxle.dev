             mob:  [T('    const form = Object.fromEntries'), C('(')] },
    { cont: true, segs: [T('      new FormData'), C('('), T('e.target'), C('))')] },
    { n: 23, wire: true, segs: [T('    const r = await sign'), C('('), T('form'), C(')')] },
    { n: 24, segs: [T('    if '), C('('), T('r.ok'), C(')'), T(' setEntries'), C('('), T('r.entries'), C(')')] },
    { n: 25, segs: [T('  '), C('}')] },
    { n: 26, segs: [T('  return '), C('<'), T('form onSubmit'), C('={'), T('submit'), C('}>')] },
    { n: 27, segs: [T('    '), C('<'), T('ul'), C('>{'), T('entries.map'), C('('), T('e '), C('=>')] },
    { n: 28, segs: [T('      '), C('<'), T('li key'), C('={'), T('e.id'), C('}><'), T('b'), C('>{'), T('e.name'), C('}</'), T('b'), C('>'), T(' '), C('{'), T('e.note'), C('}</'), T('li'), C('>)}</'), T('ul'), C('>')],
             mob:  [T('      '), C('<'), T('li key'), C('={'), T('e.id'), C('}>')] },
