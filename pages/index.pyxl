             mob:  [T('export default function Guestbook'), C('(')] },
    { cont: true, segs: [T('  '), C('{'), T(' data '), C('})'), T(' '), C('{')] },
    { n: 18, segs: [T('  const '), C('['), T('entries'), C(','), T(' setEntries'), C(']'), T(' = useState'), C('('), T('data.entries'), C(')')],
             mob:  [T('  const '), C('['), T('entries'), C(','), T(' setEntries'), C(']'), T(' =')] },
    { cont: true, segs: [T('    useState'), C('('), T('data.entries'), C(')')] },
    { n: 19, wire: true, segs: [T('  const sign = '), G('useAction'), C("('sign')")] },
    { n: 20, segs: [T('  const submit = async '), C('('), T('e'), C(')'), T(' '), C('=>'), T(' '), C('{')] },
