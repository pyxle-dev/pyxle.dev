    { n: 13, act: true, segs: [T('async def sign'), C('('), T('request'), C(','), T(' body'), C(':'), T(' Entry'), C('):')] },
    { n: 14, act: true, segs: [T('    await db.add'), C('('), T('body.name'), C(','), T(' body.note'), C(')')] },
