/* ── 08 · In the wild (live specimens) ───────────────────────────── */

const DEMOS = [
    { name: 'Today', tagline: 'To-do list, no email', href: 'https://today.pyxle.app', kind: 'today' },
    { name: 'Flux', tagline: 'SaaS analytics', href: 'https://flux.pyxle.app', kind: 'chart' },
    { name: 'Chroma', tagline: 'Color palette', href: 'https://chroma.pyxle.app', kind: 'palette' },
    { name: 'Glyph', tagline: 'Generative art', href: 'https://glyph.pyxle.app', kind: 'spiro' },
];

/* Miniature of each app — a photograph of the real thing, so the
   specimens keep their own colors inside the plate frame. */
function DemoPreview({ kind }) {
    // today — the list itself, not its login screen: warm paper, the serif
    // wordmark with its red full stop, two done rows struck through and two
    // still open. Drawn from a screenshot of the running app, so the plate stays
    // a photograph of the real thing like Chroma's palette and Flux's chart.
    if (kind === 'today') {
        const rows = [
            { done: true, w: '62%' },
            { done: true, w: '48%' },
            { done: false, w: '70%' },
            { done: false, w: '54%' },
        ];
        return (
            <div
                className="flex h-28 w-full items-center justify-center bg-[#e9e2d6]"
                aria-hidden="true"
            >
                <div className="flex h-[84%] w-[78%] flex-col rounded-[3px] bg-[#f5f1e8] px-3 py-2 shadow-[0_1px_2px_rgba(60,45,30,0.10)]">
                    <span className="font-display text-[17px] leading-none tracking-[-0.02em] text-[#241b12]">
                        Today<span className="text-[#c0492e]">.</span>
                    </span>
                    <span className="mt-[4px] h-[1.5px] w-full bg-[#ddd2c0]">
                        <span className="block h-full w-[55%] bg-[#c0492e]" />
                    </span>
                    <div className="mt-[6px] flex flex-col gap-[5px]">
                        {rows.map((r, i) => (
                            <span key={i} className="flex items-center gap-[5px]">
                                <span
                                    className={`h-[6px] w-[6px] shrink-0 rounded-full ${
                                        r.done ? 'bg-[#c0492e]' : 'border border-[#b3a289]'
                                    }`}
                                />
                                <span
                                    className={`h-[3.5px] rounded-full ${
                                        r.done ? 'bg-[#cdc0a8]' : 'bg-[#8d7b5f]'
                                    }`}
                                    style={{ width: r.w }}
                                />
                            </span>
                        ))}
                    </div>
                </div>
            </div>
        );
    }
    if (kind === 'palette') {
        return (
            <div className="flex h-28 w-full" aria-hidden="true">
                {['#FF6B6B', '#FF8E72', '#FFA45B', '#FFD166', '#F4E285'].map((c, i) => (
                    <div key={i} className="flex-1" style={{ backgroundColor: c }} />
                ))}
            </div>
        );
    }
    if (kind === 'chart') {
        const heights = [42, 58, 66, 54, 78, 72, 90];
        return (
            <div className="flex h-28 w-full items-end gap-1 bg-[#0e0f14] px-4 py-3" aria-hidden="true">
                {heights.map((h, i) => (
                    <div
                        key={i}
                        className="flex-1 rounded-t bg-gradient-to-t from-indigo-500 to-purple-600"
                        style={{ height: `${h}%`, opacity: 0.55 + (i / heights.length) * 0.45 }}
                    />
                ))}
            </div>
        );
    }
    // spiro — a deterministic spirograph, drawn server-side
    const spiroPath = Array.from({ length: 720 }, (_, i) => {
        const t = (i * Math.PI) / 40;
        const R = 45, r = 13, d = 28;
        const x = (R - r) * Math.cos(t) + d * Math.cos(((R - r) * t) / r);
        const y = (R - r) * Math.sin(t) - d * Math.sin(((R - r) * t) / r);
        return `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y.toFixed(1)}`;
    }).join(' ');
    return (
        <div className="flex h-28 w-full items-center justify-center bg-[#08080c]" aria-hidden="true">
            <svg viewBox="-90 -90 180 180" className="h-full w-auto py-1.5">
                <path d={spiroPath} fill="none" stroke="#22d3ee" strokeWidth="1" opacity="0.8" />
            </svg>
        </div>
    );
}

