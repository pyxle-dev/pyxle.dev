import './styles/error.css';
import React from 'react';
import { Head, Link } from 'pyxle/client';

/* ════════════════════════════════════════════════════════════════
   THE WORKING COPY · the error boundary — the fault, quoted.
   error.pyxl is the nearest boundary for any loader or render
   fault: the server renders it when a page throws, and (since
   framework 0.5) the same file is the *client* React error
   boundary, so a fault after hydration shows this page instead of
   a blank one. One ruled block, the status as the folio numeral,
   and a Terminal bed quoting the honest generic line — internal
   details are never shown in prod; the framework sanitises server
   error messages before they reach us.

   The reload control is an <a href=""> — a same-URL navigation
   that works with JavaScript disabled or broken (which, on an
   error page, it may well be).
   ════════════════════════════════════════════════════════════════ */

const ERROR_SRC = 'https://github.com/pyxle-dev/pyxle.dev/blob/main/pages/error.pyxl';

export default function ErrorPage({ error }) {
    const e = error || {};
    const status = e.statusCode || 500;

    return (
        <>
            <Head>
                <title>{status} — Something broke | Pyxle</title>
                <meta name="robots" content="noindex" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                {/* Light bond default (the layout boot script retints it
                   pre-paint for a stored dark theme — same contract as
                   the layout's own theme-color). */}
                <meta name="theme-color" content="#FBFBF9" />
                <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
            </Head>
            <main id="main" className="er-main">
                <div className="er-wrap">
                    <div className="er-box seen">
                        <div className="rulebar">
                            <span className="tab">!! · Error</span>
                            <span className="folio" aria-hidden="true">{status}</span>
                        </div>
                        <h1>Something broke.</h1>
                        <p className="receipt">status {status} · the fault is on our side — nothing you did</p>

                        <figure className="pane er-term" style={{ margin: '36px 0 0' }}>
                            <div className="er-term-head">
                                <span>error</span>
                                <span>{status}</span>
                            </div>
                            <pre className="er-term-body"><code>
                                {'something failed while rendering this page\n'}
                                <span className="dim">logged on the server · reload, or head back to the front page</span>
                            </code></pre>
                        </figure>

                        <div className="er-row">
                            <a className="er-btn" href="">Reload the page</a>
                            <Link className="link" href="/">back to the homepage <span className="a">→</span></Link>
                        </div>

                        <p className="er-note">
                            rendered by{' '}
                            <a className="link" href={ERROR_SRC} target="_blank" rel="noreferrer">error.pyxl</a>
                            {' '}— the nearest boundary; it catches faults on the server and, after
                            hydration, in the browser
                        </p>
                    </div>
                </div>
            </main>
        </>
    );
}
