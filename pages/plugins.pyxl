@server
async def load_plugins_page(request):
    import json
    import os
    from pathlib import Path

    from pyxle import __version__

    registry_path = Path(os.getcwd()) / "public" / "plugins-registry.json"
    registry = json.loads(registry_path.read_text(encoding="utf-8"))
    return {"version": __version__, "registry": registry}


import './styles/plugins.css';
import React from 'react';
import { Link } from 'pyxle/client';
import { PageMeta } from './components/page-meta.jsx';
import { Rulebar, Receipt, CopyChip, Pane, PaneHead, useSeen } from './components/kit.jsx';

/* ════════════════════════════════════════════════════════════════
   THE WORKING COPY · /plugins — the directory.

   The homepage's framework table grown into a registry: one plugin per hairline
   cell — mono tab + the released version straight from
   public/plugins-registry.json, a real four-line usage specimen on
   a Deck bed, the registry's own spec lines, and docs → with its
   path ghost. Everything still renders from the registry (cards,
   versions, spec rows, slot counts), so new community plugins
   appear with no page rewrite; the specimen map below is keyed by
   name and simply absent for plugins it doesn't know.

   The founding cohort is a printed slot ledger — ruled rows, NOT a
   fake terminal (dark beds are reserved for real terminal quotes).
   Counts in every receipt are computed from the registry, never
   typed. Specimens are real API: pyxle-db and pyxle-mail lines are
   lifted from this site's own db.py / index.pyxl, the useAuth lines
   from the pyxle-auth docs.
   ════════════════════════════════════════════════════════════════ */

const SUBMIT_URL = 'https://github.com/pyxle-dev/pyxle-plugins/issues/new?template=submit-plugin.yml';

/* real usage, four lines each — keyed by name; unknown plugins simply
   render without a specimen (registry-driven law: no page edit needed) */
const SPECIMENS = {
    'pyxle-db': (
        <pre className="pl-art"><code>
            {'from pyxle_db import get_database\n\n'}
            {'db = get_database'}<span className="c">()</span>{'\n'}
            {'row = await db.fetchone'}<span className="c">(</span>{'"SELECT …"'}<span className="c">)</span>
        </code></pre>
    ),
    'pyxle-auth': (
        <pre className="pl-art"><code>
            {'const '}<span className="c">{'{'}</span>{' user, isAuthenticated,'}{'\n'}
            {'        logout '}<span className="c">{'}'}</span>{' = useAuth'}<span className="c">()</span>{'\n'}
            {'if '}<span className="c">(!</span>{'isAuthenticated'}<span className="c">)</span>{'\n'}
            {'  return '}<span className="c">&lt;</span>{'a href'}<span className="c">="/login"&gt;</span>{'Sign in'}<span className="c">&lt;/</span>{'a'}<span className="c">&gt;</span>
        </code></pre>
    ),
    'pyxle-mail': (
        <pre className="pl-art"><code>
            {'mail = get_mail_service'}<span className="c">()</span>{'\n\n'}
            {'await mail.send'}<span className="c">(</span>{'to=email,\n'}
            {'    subject=subject, html=html'}<span className="c">)</span>
        </code></pre>
    ),
};

function PluginCell({ plugin, delay }) {
    const spec = SPECIMENS[plugin.name] || null;
    return (
        <div className="pl-cell rv" style={{ '--rvd': delay }}>
            <h3 className="pl-tab">
                {plugin.name}
                {plugin.version ? <span className="pl-ver">{plugin.version}</span> : null}
                <span className="pl-cat">{(plugin.category || plugin.tier || '').toLowerCase()}</span>
            </h3>
            {spec}
            <ul className="pl-hls">
                {(plugin.highlights || [plugin.description]).map((r) => <li key={r}>{r}</li>)}
            </ul>
            <CopyChip text={`pip install ${plugin.name}`} />
            <p className="pl-links">
                <Link className="link" href={plugin.docs}>docs <span className="a">→</span></Link>
                <a className="link" href={plugin.pypi} target="_blank" rel="noreferrer">pypi</a>
                <a className="link" href={plugin.repo} target="_blank" rel="noreferrer">source</a>
                <span className="pl-path">{plugin.docs}</span>
            </p>
        </div>
    );
}

/* ── 01 · the official registry ──────────────────────────────────── */

function OfficialSection({ officials }) {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-official${seen ? ' seen' : ''}`} id="official">
            <div className="frame">
                <Rulebar tab="01 · Official" href="#official" folio="01" />
                <div className="sec-head rv">
                    <h2>The plugins Pyxle ships.</h2>
                    <Receipt>
                        {officials.length} official, on PyPI · CI against live PostgreSQL and MySQL ·
                        fail-secure by default · core-team built, same bar as everyone
                    </Receipt>
                </div>
                <div className="pl-cells">
                    {officials.map((p, i) => (
                        <PluginCell key={p.name} plugin={p} delay={`${0.05 + i * 0.07}s`} />
                    ))}
                </div>
            </div>
        </section>
    );
}

/* ── 02 · the founding cohort — a printed slot ledger ────────────── */

function FoundingSection({ open, total, slots }) {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-founding${seen ? ' seen' : ''}`} id="founding">
            <div className="frame">
                <Rulebar tab="02 · Founding" href="#founding" folio="02" />
                <div className="sec-head rv">
                    <h2>Be one of the first five.</h2>
                    <Receipt>a launch program, not a club · {open} of {total} slots open — the ledger below is the live count</Receipt>
                </div>
                <div className="pl-founding">
                    <div className="pl-slots rv" style={{ '--rvd': '.06s' }}>
                        {slots.map((entry, i) => (
                            <p key={entry ? entry.name : `slot-${i}`} className={`pl-slot${entry ? ' claimed' : ''}`}>
                                <span className="sn">slot {String(i + 1).padStart(2, '0')}</span>
                                <span className="sp">{entry ? `${entry.name} — ${(entry.category || 'community').toLowerCase()}` : 'open — could be yours'}</span>
                                <span className="ss">{entry ? 'claimed' : 'unclaimed'}</span>
                            </p>
                        ))}
                    </div>
                    <div className="pl-grants rv" style={{ '--rvd': '.14s' }}>
                        <p className="pl-grant"><span className="fk">recognition</span><span className="fv">a permanent place among the plugins that started the ecosystem</span></p>
                        <p className="pl-grant"><span className="fk">spotlight</span><span className="fv">a featured slot here + a launch write-up from the official account</span></p>
                        <p className="pl-grant"><span className="fk">review</span><span className="fv">core-team code review and pairing while you build</span></p>
                        <p className="pl-grant"><span className="fk">seat</span><span className="fv">co-design input on Phase B — plugin pages &amp; routes — before it ships</span></p>
                    </div>
                </div>
                <Receipt className="rv" style={{ marginTop: 24, '--rvd': '.18s' }}>
                    ship under your own name — pyxle-* stays official · community plugins aren&rsquo;t
                    security-audited by the core team · after the cohort, the directory stays open to everyone
                </Receipt>
            </div>
        </section>
    );
}

/* ── 03 · build one — three printed steps ────────────────────────── */

function BuildSection({ version }) {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-build${seen ? ' seen' : ''}`} id="build">
            <div className="frame">
                <Rulebar tab="03 · Build one" href="#build" folio="03" />
                <div className="sec-head rv">
                    <h2>Three steps to a founding slot.</h2>
                    <Receipt>services and middleware today — pages next, co-designed in the open</Receipt>
                </div>
                <div className="pl-steps">
                    <div className="pl-step rv" style={{ '--rvd': '.04s' }}>
                        <span className="n" aria-hidden="true">01</span>
                        <span className="t">Pick a quest</span>
                        <div className="b2">
                            <p className="l">the ideas page lists what the ecosystem needs — each with its contract and an honest size estimate</p>
                            <p className="go"><Link className="link" href="/docs/plugins/ideas">browse the ideas <span className="a">→</span></Link></p>
                        </div>
                    </div>
                    <div className="pl-step rv" style={{ '--rvd': '.1s' }}>
                        <span className="n" aria-hidden="true">02</span>
                        <span className="t">Clear the bar</span>
                        <div className="b2">
                            <p className="l">published, finite standards — packaging, behaviour, testing, security, maintenance · the official plugins are the reference implementation</p>
                            <p className="go"><Link className="link" href="/docs/plugins/standards">read the standards <span className="a">→</span></Link></p>
                        </div>
                    </div>
                    <div className="pl-step rv" style={{ '--rvd': '.16s' }}>
                        <span className="n" aria-hidden="true">03</span>
                        <span className="t">Submit early</span>
                        <div className="b2">
                            <p className="l">open the submission issue while you build — the slot is visibly claimed, review happens alongside</p>
                            <p className="go"><a className="link" href={SUBMIT_URL} target="_blank" rel="noreferrer">open a submission <span className="a">→</span></a></p>
                        </div>
                    </div>
                </div>
                <div className="pl-close rv" style={{ '--rvd': '.14s' }}>
                    <CopyChip text="pip install pyxle-framework" />
                    <Link className="link" href="/docs/plugins/rfc-plugin-pages">read the Phase B RFC <span className="a">→</span></Link>
                </div>
                <Receipt className="rv" style={{ marginTop: 20, '--rvd': '.18s' }}>
                    MIT · {version ? `v${version}` : 'pre-1.0'} · Python 3.10+ · pre-1.0
                </Receipt>
            </div>
        </section>
    );
}

/* ── page ────────────────────────────────────────────────────────── */

export default function PluginsPage({ data }) {
    const { version, registry } = data;
    const officials = registry.plugins.filter((p) => p.tier === 'official');
    const community = registry.plugins.filter((p) => p.tier !== 'official');
    const total = (registry.founding && registry.founding.slots_total) || 5;
    const open = Math.max(0, total - community.length);
    const slots = Array.from({ length: total }, (_, i) => community[i] || null);
    /* the hero's running head is visible from the start (f.js law) */
    const [heroRef, heroSeen] = useSeen({ immediate: true });

    return (
        <>
            <PageMeta
                title="Plugins"
                description={`A plugin is one line of config. ${officials.length} official plugins ship today — ${officials.map((p) => p.name).join(', ')} — and ${open} founding slots are open to the community.`}
                path="/plugins"
            />
            <main id="main">
                <section ref={heroRef} className={`sec pl-hero${heroSeen ? ' seen' : ''}`} id="top">
                    <div className="frame">
                        <Rulebar hero tab="Plugins · The directory" />
                        <div className="pl-hero-head">
                            <h1 className="b" style={{ '--bd': '.05s' }}>Built to be built on.</h1>
                            <Receipt className="b" style={{ '--bd': '.16s' }}>
                                a plugin is one line of config · {officials.length} official on PyPI ·
                                {' '}{open} of {total} founding slots open
                            </Receipt>
                        </div>
                        <div className="pl-claim b" style={{ '--bd': '.28s' }}>
                            <Pane>
                                <PaneHead>
                                    <span>pyxle.config.json</span>
                                    <span>wired at startup</span>
                                </PaneHead>
                                {/* valid JSON, kept honest: annotations live in the
                                    caption, not as comments JSON can't carry */}
                                <pre className="pl-code"><code>
                                    <span className="row"><span className="n">1</span><span className="c">{'{'}</span></span>
                                    <span className="row"><span className="n">2</span>{'  "plugins"'}<span className="c">{': ['}</span></span>
                                    <span className="row"><span className="n">3</span>{'    "pyxle-db"'}<span className="c">,</span></span>
                                    <span className="row"><span className="n">4</span>{'    "pyxle-auth"'}<span className="c">,</span></span>
                                    <span className="row"><span className="n">5</span>{'    "pyxle-mail"'}</span>
                                    <span className="row"><span className="n">6</span><span className="c">{'  ]'}</span></span>
                                    <span className="row"><span className="n">7</span><span className="c">{'}'}</span></span>
                                </code></pre>
                            </Pane>
                            <p className="pl-cap">
                                each line turns a service on at startup — <b>no glue code</b> between config
                                and request: pyxle-db → request.state.db · pyxle-auth → session middleware ·
                                pyxle-mail → get_mail_service()
                            </p>
                        </div>
                    </div>
                </section>
                <OfficialSection officials={officials} />
                <FoundingSection open={open} total={total} slots={slots} />
                <BuildSection version={version} />
            </main>
        </>
    );
}
