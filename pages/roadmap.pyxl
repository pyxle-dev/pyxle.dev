@server
async def load_roadmap(request):
    from pyxle import __version__
    return {"version": __version__}


import React, { useEffect, useRef } from 'react';
import { Head } from 'pyxle/client';
import {
    useScrollReveal, EditorialLink, InkButton,
    GpSection, GpHead, GalleyFooter,
} from './components/galley.jsx';

/* ════════════════════════════════════════════════════════════════
   GALLEY PROOF — /roadmap. Three sections and no more: what's done,
   what's in progress, what's upcoming. One ink line draws itself down
   the page as you scroll — solid through what shipped, pulsing where
   the press is running, hollow into what's ahead.

   Shipped entries stay one line each and cite their release; the
   version chip links to that entry in the changelog, which is where
   the detail belongs. Do not re-expand this into a section per
   release — the changelog already is that.
   ════════════════════════════════════════════════════════════════ */

export const slots = {
    'nav-extra': () => (
        <a
            href="https://github.com/pyxle-dev/pyxle.dev/blob/main/pages/roadmap.pyxl"
            target="_blank"
            rel="noreferrer"
            title="View this page's source"
            className="focus-ring hidden rounded font-mono text-[13px] text-ink2 transition-colors hover:text-ink lg:inline"
        >
            source ↗
        </a>
    ),
};
export const createSlots = () => slots;

