@server
async def load_roadmap(request):
    from pyxle import __version__
    return {"version": __version__}


import './styles/roadmap.css';
import React from 'react';
import { Link } from 'pyxle/client';
import { PageMeta } from './components/page-meta.jsx';
import { Rulebar, Receipt, CopyChip, useSeen } from './components/kit.jsx';

/* ════════════════════════════════════════════════════════════════
   THE WORKING COPY · /roadmap — the ledger.

   One left rule runs the page; every release is a station on it —
   mono version tag in the margin, claim in sans, what actually
   landed as a mono receipt. The current work wears the WORKING COPY
   stamp (the device's one reuse outside the homepage) and its
   stations carry the LIVE chip, because they are literally running.
   The future is set in Graphite with no dates at all: nothing ahead
   carries a date it can't keep. `pre-1.0 · API may change` is
   printed on the stamp — a fact, not a footnote.

   Every shipped line cites its release and links the changelog;
   detail belongs to /docs/changelog, so shipped entries stay one
   line each. The version in the stamp and the closing facts comes
   from pyxle.__version__ via the loader — never typed.
   ════════════════════════════════════════════════════════════════ */

function Station({ tag, cls, live, title, children, delay }) {
    return (
        <div className={`rm-st rv${cls ? ` ${cls}` : ''}`} style={delay ? { '--rvd': delay } : undefined}>
            <span className="rm-tag">{tag}</span>
            <div className="rm-body">
                <h3 className="rm-t">
                    {title}
                    {live ? <span className="rm-live"><i aria-hidden="true" />live</span> : null}
                </h3>
                <p className="rm-l">{children}</p>
            </div>
        </div>
    );
}

/* ── 01 · shipped — released, documented, running in production ──── */

function ShippedSection() {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-shipped${seen ? ' seen' : ''}`} id="shipped">
            <div className="frame">
                <Rulebar tab="01 · Shipped" href="#shipped" folio="01" />
                <div className="sec-head rv">
                    <h2>Executed.</h2>
                    <Receipt>released, documented, running in production — one line per release; the detail is the <Link className="link" href="/docs/changelog">changelog</Link></Receipt>
                </div>
                <div className="rm-led">
                    <Station tag={<Link href="/docs/changelog">v0.1–0.2</Link>} title="The one-file core" delay=".04s">
                        loader · actions · React component in one .pyxl — server-rendered, hydrated, hot-reloading, file-routed
                    </Station>
                    <Station tag={<Link href="/docs/changelog#030">v0.3</Link>} title="Plugins, realtime, the nav cache" delay=".08s">
                        pyxle.config.json wires services at startup · WebSocket endpoints · client navigation cache
                    </Station>
                    <Station tag={<Link href="/docs/changelog#040">v0.4</Link>} title="The production story" delay=".12s">
                        edge caching, per-route TTLs · sanitized production errors · layout loaders · faster static path · live route changes
                    </Station>
                    <Station tag={<Link href="/docs/changelog#043">v0.4.3</Link>} title="Multi-core serving, a security wave" delay=".16s">
                        serve --workers N, one server per core · small assets from memory · HEAD allowlist · CSRF path boundaries
                    </Station>
                    <Station tag={<Link href="/docs/changelog#050">v0.5</Link>} title="The depth release" delay=".2s">
                        Pydantic actions + OpenAPI · streaming SSR through &lt;Suspense&gt; · SSG &amp; ISR · pub/sub · background work · observability · &lt;Image&gt; · rate limiter · type-aware JSX
                    </Station>
                    <Station tag={<Link href="/docs/changelog#060">v0.6</Link>} title="Your app, in Markdown" delay=".24s">
                        every page answers in .md at its URL · generated /llms.txt · discovery headers — this page has a twin
                    </Station>
                    <Station tag={<Link href="/docs/changelog#070">v0.7</Link>} title="The hardened run" delay=".28s">
                        React 19 · Vite 7 · concurrent streaming SSR, per-request isolation · calmer dev server · shadcn/ui end to end
                    </Station>
                    <Station tag={<Link href="/docs/changelog#080">v0.8</Link>} title="Studio &amp; the debugger" delay=".32s">
                        /__pyxle/studio in pyxle dev · breakpoints on both halves of a .pyxl at once · tracebacks that name your source
                    </Station>
                    <Station tag={<Link href="/docs/changelog#090">v0.9</Link>} title="The honest dev loop" delay=".36s">
                        a page that won&rsquo;t compile is an error, not a 404 · a JSX typo fails the rebuild · errors name the file · overlay survives reload
                    </Station>
                    <Station tag={<Link href="/plugins">plugins 0.2</Link>} title="Official plugins on PyPI" delay=".4s">
                        pyxle-db · pyxle-auth · pyxle-mail — CI against live PostgreSQL and MySQL
                    </Station>
                    <Station tag={<Link href="/benchmarks">site</Link>} title="Benchmarks in the open" delay=".44s">
                        reproducible two-box runs · six rival frameworks · load generator on its own hardware · losses shown next to wins
                    </Station>
                </div>
            </div>
        </section>
    );
}

/* ── 02 · executing — the caret is here ──────────────────────────── */

function NowSection() {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-now${seen ? ' seen' : ''}`} id="now">
            <div className="frame">
                <Rulebar tab="02 · Executing" href="#now" folio="02" />
                <div className="sec-head rv">
                    <h2>In motion, now.</h2>
                    <Receipt>both stations are live — not announcements</Receipt>
                </div>
                <div className="rm-led">
                    <Station tag="live" live title="The founding plugin cohort" delay=".04s">
                        first five community plugins to clear the published bar · spotlight, core-team review, a roadmap seat · <Link className="link" href="/plugins">claim a slot</Link>
                    </Station>
                    <Station tag="live" live title="RFC — plugin routes &amp; pages" delay=".1s">
                        Phase B, co-designed in the open with founding authors · <Link className="link" href="/docs/plugins/rfc-plugin-pages">read the RFC</Link>
                    </Station>
                </div>
            </div>
        </section>
    );
}

/* ── 03 · queued — in rough order, undated on purpose ────────────── */

function QueuedSection({ version }) {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-queued${seen ? ' seen' : ''}`} id="queued">
            <div className="frame">
                <Rulebar tab="03 · Queued" href="#queued" folio="03" />
                <div className="sec-head rv">
                    <h2>Ahead, in rough order.</h2>
                    <Receipt>planned · subject to change · never dated — when something moves, it moves up</Receipt>
                </div>
                <div className="rm-led">
                    <Station cls="q" tag="B1" title="Plugins ship API routes" delay=".04s">
                        pyxle-auth&rsquo;s sign-in endpoints out of the box · webhook plugins own their URLs, right CSRF posture
                    </Station>
                    <Station cls="q" tag="B2" title="Plugins ship pages" delay=".08s">
                        sign-in screens · dashboards · the admin-panel moment
                    </Station>
                    <Station cls="q" tag="·" title="Capability contracts" delay=".12s">
                        framework interfaces for mail, storage, cache — providers swappable by config, adapters from the community
                    </Station>
                    <Station cls="q" tag="·" title="The ecosystem quests" delay=".16s">
                        mail · storage · jobs · observability — <Link className="link" href="/docs/plugins/ideas">browse the ideas</Link>
                    </Station>
                    <Station cls="q" tag="·" title="TypeScript, all the way through" delay=".2s">
                        .tsx inside your .pyxl · loader-data types generated from the Python side · typecheck gate shipped in v0.5
                    </Station>
                    <Station cls="q" tag="·" title="The component inspector" delay=".24s">
                        click any element → the .pyxl that rendered it · bundle-size treemap for the client build
                    </Station>
                    <Station cls="q" tag="·" title="Deeper editor tooling" delay=".28s">
                        diagnostics, completions, go-to-definition across the Python↔JSX boundary · pyxle check grows into a linter
                    </Station>
                    <Station cls="q" tag="·" title="The Pyxle blog" delay=".32s">
                        engineering notes — how the SSR pool works · what the benchmarks taught · what broke
                    </Station>
                    <Station cls="q" tag="1.0" title="The stability line" delay=".36s">
                        minor versions stop being allowed to break you · lands when the plugin API has proven itself, not on a date
                    </Station>
                    <Station cls="q" tag="cloud" title="Pyxle Cloud" delay=".4s">
                        push a Pyxle app, skip the server story — AI scaffolding in the mix · in development · the newsletter hears it first
                    </Station>
                </div>
                <div className="rm-close rv" style={{ '--rvd': '.14s' }}>
                    <CopyChip text="pip install pyxle-framework" />
                    <a className="link" href="https://github.com/pyxle-dev/pyxle-plugins/issues/new?template=submit-plugin.yml" target="_blank" rel="noreferrer">
                        claim a founding slot <span className="a">→</span>
                    </a>
                </div>
                <Receipt className="rv" style={{ marginTop: 20, '--rvd': '.18s' }}>
                    MIT · {version ? `v${version}` : 'pre-1.0'} · Python 3.10+ · 0.1 → 0.9 in under five months
                </Receipt>
            </div>
        </section>
    );
}

/* ── page ────────────────────────────────────────────────────────── */

export default function RoadmapPage({ data }) {
    const version = data && data.version;
    /* the hero's running head is visible from the start (f.js law) */
    const [heroRef, heroSeen] = useSeen({ immediate: true });
    return (
        <>
            <PageMeta
                title="Roadmap"
                description="The Pyxle roadmap as a printed ledger: every shipped line cites its release, the current work wears the WORKING COPY stamp, and nothing ahead carries a date it can't keep."
                path="/roadmap"
            />
            <main id="main">
                <section ref={heroRef} className={`sec rm-hero${heroSeen ? ' seen' : ''}`} id="top">
                    <div className="frame">
                        <Rulebar hero tab="Roadmap · The ledger" />
                        <div className="rm-hero-head">
                            <h1 className="b" style={{ '--bd': '.05s' }}>Every shipped line cites its release.</h1>
                            <Receipt className="b" style={{ '--bd': '.16s' }}>
                                0.1 → 0.9 in under five months · ahead is undated on purpose ·
                                the detail lives in the <Link className="link" href="/docs/changelog">changelog</Link>
                            </Receipt>
                            {/* the stamp's one reuse: the ledger's "you are here" */}
                            <div className="rm-stamp b b-stamp" style={{ '--bd': '.5s' }} aria-label={`working copy — version ${version || 'pre-1.0'}, pre-1.0, API may change`}>
                                <span className="rm-stamp-top">Working copy</span>
                                <span className="rm-stamp-mid">{version ? `v${version}` : 'pre-1.0'} · executing</span>
                                <span className="rm-stamp-low">pre-1.0 · API may change</span>
                            </div>
                        </div>
                    </div>
                </section>
                <ShippedSection />
                <NowSection />
                <QueuedSection version={version} />
            </main>
        </>
    );
}
