@server
async def load_compare(request):
    from pyxle import __version__
    return {"version": __version__}


import './styles/f-compare.css';
import React from 'react';
import { Link } from 'pyxle/client';
import { PageMeta } from './components/e-meta.jsx';
import { Rulebar, Receipt, CopyChip, useSeen } from './components/f-kit.jsx';

/* ════════════════════════════════════════════════════════════════
   F — THE WORKING COPY · /compare — the printed spec sheet.

   One ruled table per rival — Next.js + FastAPI, Reflex, Django —
   with shared hairline cells, every value in mono, and a couplet
   head naming the position. Rows are what a request actually does,
   not adjectives; each table closes with the honest "when to pick
   them" line, and the page ends with a plain ruled list of what
   Pyxle doesn't do. The one dark bed quotes a real terminal (the
   grep transcript off a real production build).

   Numbers appear only with their conditions (July 2026 · Pyxle
   0.7.1); the full datasheet with the losses is /benchmarks. No
   cards, no icons, no score dots — facts in cells, checkable
   against each framework's own docs.
   ════════════════════════════════════════════════════════════════ */

/* the pyxle-cell token colours: g = the anatomy that runs (job 5) */
const G = (s) => <span className="g">{s}</span>;

const RIVALS = [
    {
        id: 'next-fastapi',
        tab: '01 · Next.js + FastAPI',
        folio: '01',
        who: 'next + fastapi',
        h2: 'Same job as Next.js. One language fewer.',
        receipt: 'the default split stack — a TypeScript frontend calling a Python API',
        rows: [
            ['services to run', 'two — a Next server and a FastAPI service', 'one — the page and its backend are the same process'],
            ['languages', 'TypeScript + Python', 'Python + JSX, in one file'],
            ['one field, DB → component', 'Note → response_model → openapi.json → types.gen.ts → fetch → props', 'loader return → props'],
            ['representations in sync', '6 · 3 places to drift', '1 · 0 places to drift'],
            ['server logic', 'FastAPI routes, a hand-kept contract away', <>{G('@server')} loaders · {G('@action')} mutations — same file as the JSX</>],
            ['streaming SSR', 'yes — RSC', <>yes — {'<Suspense>'}, React 18/19</>],
            ['SSR throughput, per core', '1.0 — the reference', <>~2.2× — measured July 2026 on Pyxle 0.7.1 · <Link className="link" href="/benchmarks">/benchmarks</Link></>],
            ['HTML for the same DOM', 'carries the RSC hydration payload', '2–3× fewer bytes — same run'],
            ['deploy', 'two deploys · CORS between them', 'one process · any ASGI host'],
        ],
        note: 'pick the split when frontend and backend are different teams — the contract is then a feature, not a tax',
    },
    {
        id: 'reflex',
        tab: '02 · Reflex',
        folio: '02',
        who: 'reflex',
        h2: 'Also pure Python. Not real React.',
        receipt: 'the closest cousin — and the clearest fork in the road',
        rows: [
            ['components', "a wrapped set — the framework's own component system", 'real React — npm-install anything'],
            ['writing JSX', "never — that's the promise", 'yes — real JSX, same file as the Python'],
            ['one field, DB → component', 'rx.State → diff over WebSocket → wrapped var', 'loader return → props'],
            ['where UI events run', 'on the server, over a WebSocket', 'in the browser — plain React state'],
            ['streaming SSR on React 19', 'partial', <>yes — {'<Suspense>'}, shell first</>],
            ['breakpoints, both halves', '—', 'one .pyxl file — Python and JSX in the same debug session'],
        ],
        note: 'pick Reflex when nobody on the team will ever write JSX — that constraint is its whole design',
    },
    {
        id: 'django',
        tab: '03 · Django',
        folio: '03',
        who: 'django',
        h2: 'The batteries reference. Templates, not components.',
        receipt: 'twenty years of admin, ORM and auth — with a template language at the end',
        rows: [
            ['UI layer', 'server templates — types end at the template', 'React components, server-rendered then hydrated'],
            ['one field, DB → component', 'QuerySet → context → template', 'loader return → props'],
            ['admin panel', 'the reference — still unmatched', 'not built in'],
            ['React SSR', 'not built in', 'streaming, React 18/19'],
            ['one file per feature', 'models + views + urls + templates', <>loader, {G('@action')}, component — one .pyxl</>],
        ],
        note: 'pick Django when the admin is the product — Pyxle does not have one',
    },
];

function RivalSection({ rival }) {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-rival${seen ? ' seen' : ''}`} id={rival.id}>
            <div className="frame">
                <Rulebar tab={rival.tab} href={`#${rival.id}`} folio={rival.folio} />
                <div className="sec-head rv">
                    <h2>{rival.h2}</h2>
                    <Receipt>{rival.receipt}</Receipt>
                </div>
                <div className="cmp-table rv" style={{ '--rvd': '.08s' }} role="table">
                    <div className="cmp-c cmp-h" role="columnheader" aria-hidden="true" />
                    <div className="cmp-c cmp-h" role="columnheader">{rival.who}</div>
                    <div className="cmp-c cmp-h us" role="columnheader">pyxle</div>
                    {rival.rows.map(([label, them, us]) => (
                        <React.Fragment key={label}>
                            <div className="cmp-c cmp-l" role="rowheader">{label}</div>
                            <div className="cmp-c cmp-a" role="cell"><span className="cmp-who">{rival.who}</span>{them}</div>
                            <div className="cmp-c cmp-b" role="cell"><span className="cmp-who">pyxle</span>{us}</div>
                        </React.Fragment>
                    ))}
                </div>
                <Receipt className="rv" style={{ marginTop: 18, '--rvd': '.14s' }}>{rival.note}</Receipt>
            </div>
        </section>
    );
}

/* ── 04 · the split, proven — a real terminal, real bytes ────────── */

function ProofSection() {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-proof${seen ? ' seen' : ''}`} id="proof">
            <div className="frame">
                <Rulebar tab="04 · The split, proven" href="#proof" folio="04" />
                <div className="sec-head rv">
                    <h2>One representation. Measured.</h2>
                    <Receipt>real bytes off a real production build — not a diagram</Receipt>
                </div>
                <div className="cmp-proof">
                    <div className="rv" style={{ '--rvd': '.08s' }}>
                        <div className="cmp-term">
                            <div className="cmp-term-head"><span>terminal</span><span>dist/ · production build</span></div>
                            <pre className="cmp-term-body"><code>
                                <span className="d">$</span>{' grep -c \'find_notes\\|remember\\|SavedSearch\' \\\n      dist/assets/search-*.js\n'}
                                <span className="big">0</span>{'\n\n'}
                                <span className="c">{'# the loader’s server code, absent from the\n# client bundle by construction — not minifier luck'}</span>
                            </code></pre>
                        </div>
                        <p className="cmp-term-cap">the search page&rsquo;s own loader, grepped for in its shipped JS</p>
                    </div>
                    <div className="cmp-facts rv" style={{ '--rvd': '.16s' }}>
                        <p className="cmp-fact"><span className="fk">GET /search?q=in</span><span className="fv">2,020 B — the whole HTML document</span></p>
                        <p className="cmp-fact"><span className="fk">the page&rsquo;s client chunk</span><span className="fv">2.6 KB · 1.3 KB gzipped</span></p>
                        <p className="cmp-fact"><span className="fk">invalid @action body</span><span className="fv">a real Pydantic 422 — the action never runs</span></p>
                        <p className="cmp-fact"><span className="fk">dynamic SSR, per core</span><span className="fv">~2.2× Next.js — July 2026, Pyxle 0.7.1 · <Link className="link" href="/benchmarks">/benchmarks</Link></span></p>
                        <p className="cmp-fact"><span className="fk">database-query pages</span><span className="fv">1.31× FastAPI&rsquo;s throughput — same run</span></p>
                        <p className="cmp-fact"><span className="fk">under load</span><span className="fv">0 errors · 2,500+ tests · 95% coverage gate</span></p>
                    </div>
                </div>
            </div>
        </section>
    );
}

/* ── 05 · what Pyxle doesn't do — receipts, not trash talk ───────── */

const NOTS = [
    ['no admin panel', <>Django&rsquo;s is still the reference. If the admin is the product, use Django.</>],
    ['no Python-only promise', <>JSX here is real JSX. A team that will never write it is better served by Reflex.</>],
    ['no raw-JSON crown', <>Node ultralights like Hono own that workload — printed in our own losses. <Link className="link" href="/benchmarks">/benchmarks</Link></>],
    ['no 1.0 stability line yet', <>pre-1.0 — minor versions may still break you. The line lands when the plugin API has proven itself. <Link className="link" href="/roadmap">/roadmap</Link></>],
    ['no managed cloud today', <>self-host on any ASGI box. Pyxle Cloud is in development — the newsletter below hears it first.</>],
];

function NotsSection({ version }) {
    const [ref, seen] = useSeen();
    return (
        <section ref={ref} className={`sec sec-nots${seen ? ' seen' : ''}`} id="honest">
            <div className="frame">
                <Rulebar tab="05 · The other column" href="#honest" folio="05" />
                <div className="sec-head rv">
                    <h2>What Pyxle doesn&rsquo;t do.</h2>
                    <Receipt>a spec sheet that only lists wins is an ad — when the others are the right call</Receipt>
                </div>
                <div className="cmp-nots rv" style={{ '--rvd': '.08s' }}>
                    {NOTS.map(([k, v]) => (
                        <p key={k} className="cmp-not"><span className="k">{k}</span><span className="v">{v}</span></p>
                    ))}
                </div>
                <div className="cmp-close rv" style={{ '--rvd': '.16s' }}>
                    <CopyChip text="pip install pyxle-framework" />
                    <Link className="link" href="/playground">run it in the browser <span className="a">→</span></Link>
                </div>
                <Receipt className="rv" style={{ marginTop: 20, '--rvd': '.2s' }}>
                    MIT · {version ? `v${version}` : 'pre-1.0'} · Python 3.10+ · the long-form guide
                    {' '}→ <Link className="link" href="/docs/guides/comparison">/docs/guides/comparison</Link>
                </Receipt>
            </div>
        </section>
    );
}

/* ── page ────────────────────────────────────────────────────────── */

export default function ComparePage({ data }) {
    const version = data && data.version;
    /* the hero's running head is visible from the start (f.js law) */
    const [heroRef, heroSeen] = useSeen({ immediate: true });
    return (
        <>
            <PageMeta
                title="Compare"
                description="The printed spec sheet: Pyxle beside Next.js + FastAPI, Reflex, and Django — one ruled table per rival, every cell checkable against that framework's own docs, and the honest list of what Pyxle doesn't do."
                path="/compare"
            />
            <main id="main">
                <section ref={heroRef} className={`sec cmp-hero${heroSeen ? ' seen' : ''}`} id="top">
                    <div className="frame">
                        <Rulebar hero tab="Compare · The spec sheet" />
                        <div className="cmp-hero-head">
                            <h1 className="b" style={{ '--bd': '.05s' }}>Real React. Pure Python. No&nbsp;seam.</h1>
                            <Receipt className="b" style={{ '--bd': '.16s' }}>
                                three stacks, compared in their own vocabulary · every cell checkable
                                against that framework&rsquo;s docs · losses printed in section 05
                            </Receipt>
                        </div>
                    </div>
                </section>
                {RIVALS.map((rival) => <RivalSection key={rival.id} rival={rival} />)}
                <ProofSection />
                <NotsSection version={version} />
            </main>
        </>
    );
}
