import React from 'react';
import { Head } from 'pyxle/client';
import NotFoundContent from './components/not-found-content.jsx';

/* ════════════════════════════════════════════════════════════════
   F — THE WORKING COPY · /404 — no such file.
   The block itself lives in components/not-found-content.jsx
   (shared with the docs catch-all). A 404 is still a page — the
   shared layout keeps the full nav and the EOF footer around it.

   Head is set directly (not PageMeta): a 404 is noindex and gets
   no canonical or Open Graph tags — the layout's site-wide
   defaults cover crawlers that ignore robots anyway.
   ════════════════════════════════════════════════════════════════ */

export default function NotFoundPage() {
    return (
        <>
            <Head>
                <title>404 — Pyxle</title>
                <meta name="description" content="The page you are looking for does not exist." />
                <meta name="robots" content="noindex" />
            </Head>
            <main id="main" className="lost">
                <NotFoundContent />
            </main>
        </>
    );
}
